---
import Base from '../layouts/Base.astro';
import { locales, defaultLocale } from '../i18n/ui';

const altLocales = locales.filter((l) => l !== defaultLocale);
---

<Base
  locale="en"
  title="Page not found — De Freitas Lysdesign"
  description="This page does not exist."
  path="/404"
  noindex
>
  <section class="lost" data-locales={JSON.stringify(altLocales)}>
    <p class="mono-label">House lights up</p>
    <h1>This page isn't in the show.</h1>
    <p class="lost-body">
      The link is wrong or the page has moved. The room is still here, though.
    </p>
    <a class="back" href="/">Back to the room →</a>
  </section>
</Base>

<script>
  // If the broken URL was inside a locale (/fr/..., /no/...), send the
  // visitor back to that locale's homepage instead of the English root.
  const container = document.querySelector<HTMLElement>('.lost');
  const back = document.querySelector<HTMLAnchorElement>('.back');
  if (container && back) {
    const locales: string[] = JSON.parse(container.dataset.locales || '[]');
    const first = window.location.pathname.split('/').filter(Boolean)[0];
    if (first && locales.includes(first)) back.href = `/${first}/`;
  }
</script>

<style>
  .lost {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 6rem var(--pad-x);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.4rem);
    margin: 0.9rem 0 1rem;
    text-wrap: balance;
  }

  .lost-body {
    color: var(--gris);
    max-width: var(--measure);
  }

  .back {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tungsten);
    text-decoration: none;
    border: 1px solid var(--tungsten-dim);
    border-radius: 6px;
    padding: 0.7rem 1.3rem;
  }

  .back:hover {
    border-color: var(--tungsten);
  }
</style>
