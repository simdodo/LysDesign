---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";

const services = [
  {
    title: "Lighting Design",
    kicker: "Concerts / dance / festivals",
    copy: "Readable stage pictures for concerts, dance and festivals, shaped around the room, the rig and the time available.",
    points: ["Show looks", "Rig-aware design", "Cue structure"],
    priority: "primary",
    href: "/services/lighting-design/",
    cta: "Explore lighting design"
  },
  {
    title: "Lighting Programming / Operator",
    kicker: "GrandMA2 / FOH operation",
    copy: "GrandMA2 programming, FOH busking and showfile support for rooms where decisions need to happen quickly.",
    points: ["GrandMA2", "MA3 transition support", "FOH busking"],
    priority: "primary",
    href: "/services/lighting-programming/",
    cta: "Explore lighting programming"
  },
  {
    title: "Touring / Live Events",
    kicker: "International touring",
    copy: "Touring showfiles, advance notes and on-site decisions for shows moving between real venues, local rigs and festival versions.",
    points: ["Advancing", "Local rig translation", "Show-day decisions"],
    priority: "primary",
    href: "/services/touring-showfiles/",
    cta: "Explore touring showfiles"
  },
  {
    title: "Creative Direction",
    kicker: "Artist collaboration",
    copy: "Turning references, movement and music into light the artist can recognize, without ignoring the technical reality.",
    points: ["Artist process", "Music / movement", "Stage picture"],
    priority: "primary",
    href: "/services/lighting-design/",
    cta: "Explore visual design"
  },
  {
    title: "Previs / Camera Support",
    kicker: "Camera-ready environments",
    copy: "Remote showfile, Capture previs and camera-lighting support for small productions preparing a live or filmed setup.",
    points: ["Camera lighting", "Capture previs", "Practical gear lists"],
    priority: "secondary",
    href: "/services/unreal-previs/",
    cta: "Explore previs workflow"
  },
  {
    title: "Remote Showfile & Previs Support",
    kicker: "Before rehearsal",
    copy: "Showfile review, busking layout, Capture previs and programming prep before rehearsal.",
    points: ["Showfile review", "Busking layout", "Capture previs"],
    priority: "secondary",
    href: "/services/remote-showfile-support/",
    cta: "See remote support"
  }
];

const experience = [
  "Concerts",
  "Touring",
  "Contemporary dance",
  "Festivals",
  "Clubs / venues",
  "Streaming productions"
];

const workflow = [
  "GrandMA2",
  "MA3 transition support",
  "FOH busking",
  "Touring showfiles",
  "Capture previs",
  "Plot drawing"
];

const topProof = [
  "Artists",
  "Touring",
  "Venues",
  "Festivals",
  "Dance"
];

const pressureRows = [
  {
    pressure: "IF THE ROOM CHANGES",
    service: "Touring / Showfiles",
    href: "/services/touring-showfiles/"
  },
  {
    pressure: "IF TIME DISAPPEARS",
    service: "Programming / Operator",
    href: "/services/lighting-programming/"
  },
  {
    pressure: "IF MOVEMENT LEADS",
    service: "Dance / Theatre",
    href: "/services/dance-theatre-lighting/"
  },
  {
    pressure: "IF THE RIG IS NOT YOURS",
    service: "Festival Adaptation",
    href: "/services/festival-lighting/"
  },
  {
    pressure: "IF THE VENUE IS TOO LATE",
    service: "Unreal / Previs",
    href: "/services/unreal-previs/"
  }
];

const serviceComparison = [
  {
    service: "Lighting Design",
    bestFor: "New show looks, concert packages, dance work and artist-led productions that need a clear visual direction.",
    deliverables: ["Visual language", "Cue structure", "Rig-aware looks"],
    relatedHref: "/portfolio/visual-direction/",
    relatedLabel: "See visual direction work"
  },
  {
    service: "Programming / Operator",
    bestFor: "Productions that need a readable showfile, fast programming workflow, or a calm operator on the desk.",
    deliverables: ["GrandMA2 programming", "MA3 transition support", "FOH busking pages"],
    relatedHref: "/portfolio/touring-lighting-showfiles/",
    relatedLabel: "See touring showfile work"
  },
  {
    service: "Touring Showfiles",
    bestFor: "Artists and productions moving between venues, countries, festivals and local lighting systems.",
    deliverables: ["Advance notes", "Festival versions", "Local rig translation"],
    relatedHref: "/portfolio/touring-lighting-showfiles/",
    relatedLabel: "See touring adaptation"
  },
  {
    service: "Festival Lighting",
    bestFor: "Short changeovers, daylight problems, patched rigs and festival days where decisions have to be practical.",
    deliverables: ["Show-day fixes", "Local plot adaptation", "Busking workflow"],
    relatedHref: "/portfolio/festival-venue-adaptation/",
    relatedLabel: "See festival workflow"
  },
  {
    service: "Dance / Theatre",
    bestFor: "Rehearsal-led work where movement, timing, silence and black-box constraints matter.",
    deliverables: ["Cue timing", "Focus notes", "Remount support"],
    relatedHref: "/portfolio/contemporary-dance-lighting/",
    relatedLabel: "See dance lighting work"
  },
  {
    service: "Unreal / Previs",
    bestFor: "Shows, clips and live concepts that need visual decisions tested before entering the venue.",
    deliverables: ["Stage environments", "Camera checks", "Lighting concepts"],
    relatedHref: "/portfolio/unreal-visualization/",
    relatedLabel: "See previs workflow"
  },
  {
    service: "Remote Showfile Support",
    bestFor: "Artists, LDs, venues and productions preparing a showfile, busking layout or previs before rehearsal.",
    deliverables: ["Showfile review", "GrandMA2 base structure", "Capture previs"],
    relatedHref: "/services/remote-showfile-support/",
    relatedLabel: "See remote support"
  }
];

const globalProcess = [
  {
    title: "Brief",
    copy: "Collect the room, artist references, confirmed dates, known constraints and what is still missing."
  },
  {
    title: "Advance",
    copy: "Read the plot, venue information, console situation and crew reality before the first production day."
  },
  {
    title: "Design / programming",
    copy: "Build looks, cue structure and showfile logic around the actual system instead of an ideal one."
  },
  {
    title: "Adaptation / show day",
    copy: "Translate the work to the rig, solve practical gaps and keep the show readable under pressure."
  }
];
---

<Layout
  title="Lighting Services for Live Production | De Freitas"
  description="Lighting design, GrandMA programming, FOH operation, touring showfiles, festival adaptation and Capture previs from Oslo."
>
  <div class="glow"></div>

  <main class="services-page" id="main-content">
    <section class="services-hero" aria-labelledby="services-title">
      <PageLabelBar label="Services" />

      <h1 id="services-title">
        Lighting work for real production conditions.
      </h1>

      <p>
        Lighting design, GrandMA programming, FOH operation and previs for
        productions that need readable light in real rooms.
      </p>

      <ul class="hero-proof" aria-label="Credibility summary">
        {topProof.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <div class="hero-actions" aria-label="Services actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">
          Start a Project
        </a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">
          View Portfolio
        </a>
      </div>
    </section>

    <section class="services-proof" aria-label="Experience and workflow">
      <div class="proof-block">
        <span>Rooms / formats</span>
        <ul>
          {experience.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="proof-block">
        <span>Desk / workflow</span>
        <ul>
          {workflow.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="pressure-module" aria-labelledby="pressure-title">
      <div class="section-kicker">CHOOSE BY PRESSURE</div>
      <h2 id="pressure-title">Start with the problem, not the service name.</h2>

      <div class="pressure-list">
        {pressureRows.map((row) => (
          <a href={row.href}>
            <span>{row.pressure}</span>
            <strong>{row.service}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="services-grid" aria-label="Lighting design services">
      {
        services.map((service) => (
          <article class={`service-card service-card--${service.priority}`}>
            <span>{service.kicker}</span>
            <h2>{service.title}</h2>
            <p>{service.copy}</p>
            <ul>
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <a class="link-tertiary" href={service.href}>{service.cta}</a>
          </article>
        ))
      }
    </section>

    <section class="services-cta" aria-labelledby="service-comparison-title">
      <div>
        <div class="section-kicker">Where to start</div>
        <h2 id="service-comparison-title">Pick the support that fits the pressure.</h2>
      </div>

      <p>
        Most productions need a mix of design, programming, advance work and
        on-site adaptation. These routes make the first conversation faster.
      </p>
    </section>

    <section class="services-grid" aria-label="Service comparison">
      {
        serviceComparison.map((item) => (
          <article class="service-card service-card--secondary">
            <span>{item.service}</span>
            <h2>{item.bestFor}</h2>
            <ul>
              {item.deliverables.map((deliverable) => (
                <li>{deliverable}</li>
              ))}
            </ul>
            <a class="link-tertiary" href={item.relatedHref}>{item.relatedLabel}</a>
          </article>
        ))
      }
    </section>

    <section class="services-proof" aria-label="Global production process">
      {
        globalProcess.map((step) => (
          <div class="proof-block">
            <span>{step.title}</span>
            <p>{step.copy}</p>
          </div>
        ))
      }
    </section>

    <section class="services-cta" aria-labelledby="service-uncertain-title">
      <div>
        <div class="section-kicker">Not Sure?</div>
        <h2 id="service-uncertain-title">If the brief is incomplete, send it anyway.</h2>
      </div>

      <p>
        A half-confirmed room, a deadline and a list of unknowns is enough to start.
        The first step is making the production problem clear.
      </p>

      <div class="hero-actions" aria-label="Project clarity actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">
          Start a Project
        </a>
        <a class="link-tertiary" href="/portfolio/" data-track-event="cta_view_work">See similar production work</a>
      </div>
    </section>

    <section class="services-cta" aria-labelledby="services-contact-title">
      <div>
        <div class="section-kicker">Advance</div>
        <h2 id="services-contact-title">Bring the brief, the room, the deadline.</h2>
      </div>

      <p>
        Bring the music, the room and the deadline.
      </p>

      <div class="hero-actions" aria-label="Advance actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">
          Start a Project
        </a>
      </div>
    </section>
  </main>
</Layout>
