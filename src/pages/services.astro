---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";

const services = [
  {
    title: "Lighting Design",
    kicker: "Concerts / dance / festivals",
    copy: "Lighting systems that stay beautiful when production gets complicated: tight rooms, limited fixtures, moving schedules, and late creative changes.",
    points: ["Show looks", "Rig-aware design", "Cue structure"],
    priority: "primary"
  },
  {
    title: "Lighting Programming / Operator",
    kicker: "GrandMA / EOS / show control",
    copy: "Touring showfiles built for changing rooms, local crews, short load-ins, and fast programming without losing the show.",
    points: ["GrandMA / EOS", "Busking / timecode", "Tourable show files"],
    priority: "primary"
  },
  {
    title: "Touring / Live Events",
    kicker: "International touring",
    copy: "Advancing, adaptation, and on-site decisions for shows that need to survive different plots, crews, venues, and festival versions.",
    points: ["Advancing", "Local rig translation", "Show-day decisions"],
    priority: "primary"
  },
  {
    title: "Creative Direction",
    kicker: "Artist collaboration",
    copy: "Turning references, movement, music, and stage constraints into a visual system the artist can recognize night after night.",
    points: ["Artist process", "Music / movement", "Stage picture"],
    priority: "primary"
  },
  {
    title: "Consulting for Creators / Streamers",
    kicker: "Camera-ready environments",
    copy: "Camera lighting and previs decisions that solve expensive problems before the room, stream, or shoot becomes the test.",
    points: ["Camera lighting", "Unreal / previz", "Practical gear lists"],
    priority: "secondary"
  }
];

const experience = [
  "Concerts",
  "Touring",
  "Contemporary dance",
  "Festivals",
  "Clubs / venues",
  "Streaming productions"
];

const workflow = [
  "GrandMA",
  "EOS",
  "Unreal / visualization",
  "Show files",
  "Busking / timecode",
  "Touring adaptation"
];

const topProof = [
  "Artists",
  "Touring",
  "Countries",
  "Festivals",
  "Dance"
];
---

<Layout
  title="Services | De Freitas Lys Design"
  description="Lighting design, programming, touring, creative direction, and visualization from 18 years of live entertainment work."
>
  <div class="glow"></div>

  <main class="services-page" id="main-content">
    <section class="services-hero" aria-labelledby="services-title">
      <PageLabelBar label="Services" />

      <h1 id="services-title">
        Lighting work for real production conditions.
      </h1>

      <p>
        Design, programming, operation and previs for productions that need strong looks,
        readable systems and fast decisions.
      </p>

      <ul class="hero-proof" aria-label="Credibility summary">
        {topProof.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <div class="hero-actions" aria-label="Services actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">
          Start a Project
        </a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">
          View Portfolio
        </a>
      </div>
    </section>

    <section class="services-proof" aria-label="Experience and workflow">
      <div class="proof-block">
        <span>Rooms / formats</span>
        <ul>
          {experience.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="proof-block">
        <span>Desk / workflow</span>
        <ul>
          {workflow.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="services-grid" aria-label="Lighting design services">
      {
        services.map((service) => (
          <article class={`service-card service-card--${service.priority}`}>
            <span>{service.kicker}</span>
            <h2>{service.title}</h2>
            <p>{service.copy}</p>
            <ul>
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="services-cta" aria-labelledby="services-contact-title">
      <div>
        <div class="section-kicker">Advance</div>
        <h2 id="services-contact-title">Bring the brief, the room, the deadline.</h2>
      </div>

      <p>
        Send the project. We'll figure out the rest.
      </p>

      <div class="hero-actions" aria-label="Advance actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">
          Start a Project
        </a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">
          View Portfolio
        </a>
      </div>
    </section>
  </main>
</Layout>
