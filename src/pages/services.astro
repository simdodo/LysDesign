---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    title: "Lighting Design",
    kicker: "Concept / show language",
    copy: "A complete visual direction for stages, rooms, artists, and moments that need a strong identity before the first cue fires.",
    points: ["Show looks", "Fixture planning", "Cue structure"]
  },
  {
    title: "Lighting Programming / Operator",
    kicker: "Precision under pressure",
    copy: "Clean programming, responsive operation, and show files built to survive real production conditions, revisions, and fast decisions.",
    points: ["GrandMA workflows", "Timecode", "Live busking"]
  },
  {
    title: "Touring / Live Events",
    kicker: "Scalable systems",
    copy: "Lighting support for touring, festivals, concerts, and one-off live events where the design must travel, adapt, and still hit hard.",
    points: ["Advancing", "On-site execution", "Festival adaptation"]
  },
  {
    title: "Creative Direction",
    kicker: "Visual identity",
    copy: "A sharper connection between sound, artist, room, and image, built for performances that need atmosphere instead of decoration.",
    points: ["Mood systems", "Show pacing", "Stage composition"]
  },
  {
    title: "Consulting for Creators / Streamers",
    kicker: "Small spaces / big presence",
    copy: "Practical lighting strategy for creators, streamers, and small studios that need a premium look without bloated production overhead.",
    points: ["Setup design", "Gear direction", "Camera-ready lighting"]
  }
];
---

<Layout
  title="Services | De Freitas Lys Design"
  description="Lighting design, programming, touring, creative direction, and creator consulting services for live performance and visual environments."
>
  <div class="glow"></div>

  <main class="services-page">
    <section class="services-hero" aria-labelledby="services-title">
      <div class="section-kicker">Services</div>

      <h1 id="services-title">
        Lighting systems for artists, stages, and high-pressure rooms.
      </h1>

      <p>
        From first visual concept to final show call, De Freitas Lys Design builds lighting
        that gives clients a clear identity, a reliable workflow, and a stronger live impact.
      </p>

      <a class="cta" href="/contact">
        Start a Project
      </a>
    </section>

    <section class="services-grid" aria-label="Lighting design services">
      {
        services.map((service) => (
          <article class="service-card">
            <span>{service.kicker}</span>
            <h2>{service.title}</h2>
            <p>{service.copy}</p>
            <ul>
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="services-cta" aria-labelledby="services-contact-title">
      <div>
        <div class="section-kicker">Next step</div>
        <h2 id="services-contact-title">Bring the brief, the room, the deadline.</h2>
      </div>

      <p>
        Send the artist, event type, venue scale, date, and production needs. The first reply
        can define the right level of design, programming, or consulting support.
      </p>

      <a class="cta" href="/contact">
        Contact De Freitas Lys Design
      </a>
    </section>
  </main>
</Layout>
