---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
import PortfolioImage from "../components/PortfolioImage.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("portfolio", ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);

const [featuredProject, ...remainingProjects] = projects;
const secondaryProjects = remainingProjects.slice(0, 2);
const indexProjects = remainingProjects.slice(2);

const caseStudyCtas = {
  Touring: "Open touring case notes",
  Dance: "Open dance case notes",
  Festival: "Open festival case notes",
  "Visual Direction": "Open visual direction notes",
  Previsualization: "Open previs notes",
  "Special Project": "Open special project notes"
};

const editorialCaptions = {
  Touring: "FOH / touring file pressure — the show has to survive another room.",
  Dance: "Black-box read — movement, timing and silence decide the cue.",
  Festival: "Festival translation — local rig, daylight and changeover pressure.",
  "Visual Direction": "Artist-led scene — references become a repeatable visual language.",
  Previsualization: "Previs study — decisions tested before the venue becomes the first draft.",
  "Special Project": "Hybrid setup — technical solution outside normal production categories."
};

const getTone = (format) =>
  format === "Dance" || format === "Previsualization"
    ? "warm"
    : format === "Touring" || format === "Festival"
      ? "cyan"
      : "neutral";
---

<Layout
  title="Lighting Portfolio & Case Studies | De Freitas Lys"
  description="Selected lighting design, programming, touring, festival, dance and Unreal previs case studies from real live production work."
>
  <div class="glow"></div>

  <main class="portfolio-page" id="main-content">
    <section class="portfolio-hero" aria-labelledby="portfolio-title">
      <PageLabelBar label="Portfolio" />

      <h1 id="portfolio-title">Selected Work &amp; Case Studies</h1>

      <p>
        Touring systems, artist-led looks, contemporary dance, festivals, visualization, and
        case studies from live production rooms that need practical decisions fast.
      </p>

    </section>

    <section class="portfolio-grid portfolio-grid--cinematic" aria-label="Selected portfolio projects">
      {featuredProject && (
        <article
          class={`portfolio-card portfolio-card--${getTone(featuredProject.data.format)} portfolio-card--feature portfolio-card--cinematic-feature`}
          data-project={featuredProject.id}
        >
          <PortfolioImage
            image={featuredProject.data.cover}
            alt={`${featuredProject.data.title}: ${featuredProject.data.coverAlt}`}
            loading="eager"
            fetchpriority="high"
            caption={editorialCaptions[featuredProject.data.format] ?? featuredProject.data.coverAlt}
          />

          <div class="portfolio-card-body">
            <span class="portfolio-category">{featuredProject.data.role}</span>
            <h2>{featuredProject.data.title}</h2>
            <p>{featuredProject.data.description}</p>

            <dl class="portfolio-case-notes" aria-label={`${featuredProject.data.title} case study summary`}>
              <div>
                <dt>Role</dt>
                <dd>{featuredProject.data.role}</dd>
              </div>
              <div>
                <dt>System</dt>
                <dd>{featuredProject.data.systems.join(" / ")}</dd>
              </div>
              <div>
                <dt>Constraint</dt>
                <dd>{featuredProject.data.productionProblem ?? featuredProject.data.challenge}</dd>
              </div>
              <div>
                <dt>Result</dt>
                <dd>{featuredProject.data.result}</dd>
              </div>
            </dl>

            <a class="link-tertiary portfolio-link" href={`/portfolio/${featuredProject.id}/`} data-track-event="portfolio_case_study_click" data-astro-prefetch>
              {caseStudyCtas[featuredProject.data.format] ?? `${featuredProject.data.title} case study`}
            </a>
          </div>
        </article>
      )}

      {secondaryProjects.length > 0 && (
        <div class="portfolio-secondary-grid" aria-label="Secondary case studies">
          {secondaryProjects.map((project, index) => (
            <article
              class={`portfolio-card portfolio-card--${getTone(project.data.format)} portfolio-card--standard`}
              data-project={project.id}
            >
            <PortfolioImage
              image={project.data.cover}
              alt={`${project.data.title}: ${project.data.coverAlt}`}
              loading="lazy"
              caption={editorialCaptions[project.data.format] ?? project.data.coverAlt}
            />

            <div class="portfolio-card-body portfolio-card-body--quiet">
              <span class="portfolio-category">{project.data.role}</span>
              <h2>{project.data.title}</h2>
              <p>{project.data.description}</p>

              <dl class="portfolio-case-notes" aria-label={`${project.data.title} case study summary`}>
                <div>
                  <dt>Constraint</dt>
                  <dd>{project.data.productionProblem ?? project.data.challenge}</dd>
                </div>
                <div>
                  <dt>System</dt>
                  <dd>{project.data.systems.join(" / ")}</dd>
                </div>
              </dl>

              <a class="link-tertiary" href={`/portfolio/${project.id}/`} data-track-event="portfolio_case_study_click" data-astro-prefetch>
                {caseStudyCtas[project.data.format] ?? "Open case notes"}
              </a>
            </div>
          </article>
          ))}
        </div>
      )}

      {indexProjects.length > 0 && (
        <div class="portfolio-compact-index" aria-label="Compact case study index">
          <div class="section-kicker">SHOWFILE INDEX</div>
          {indexProjects.map((project) => (
            <article class="portfolio-index-row">
              <a href={`/portfolio/${project.id}/`} data-track-event="portfolio_case_study_click" data-astro-prefetch>
                <span>{project.data.format}</span>
                <strong>{project.data.title}</strong>
                <small>{project.data.role} / {project.data.year} / {project.data.systems.join(" / ")}</small>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="services-cta portfolio-cta" aria-labelledby="portfolio-contact-title">
      <div>
        <div class="section-kicker">Next Step</div>
        <h2 id="portfolio-contact-title">Send the room, the dates, and the problem.</h2>
      </div>

      <div class="hero-actions" aria-label="Portfolio contact actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        <a class="link-tertiary" href="/services/">Choose by pressure</a>
      </div>
    </section>
  </main>
</Layout>
