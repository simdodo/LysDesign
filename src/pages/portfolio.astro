---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
import PortfolioImage from "../components/PortfolioImage.astro";

const projects = [
  {
    title: "Touring Lighting / Showfiles",
    slug: "international-touring",
    description: "15+ years building touring showfiles that survive real rooms: France, Europe, international dates, local crews, festival versions, and fast programming changes.",
    tags: ["GrandMA2 / MA3", "touring showfiles", "festival versions"],
    selectedProjects: ["JAIN", "Tim Dup", "Les Tambours du Bronx"],
    metadata: {
      years: "2006-present",
      location: "France / Europe / international",
      role: "Touring LD / programmer / operator",
      proof: ["local crew adaptation", "fast programming workflows", "rig-to-rig translation"]
    },
    image: "/images/portfolio/touring/cover.jpg",
    href: "/portfolio/touring-lighting-showfiles/",
    cta: "Discuss Touring Support",
    tone: "cyan",
    layout: "feature"
  },
  {
    title: "CONTEMPORARY DANCE LIGHTING",
    slug: "contemporary-dance",
    description: "Lighting built inside the rehearsal process with performers and choreographers. Movement-driven cueing, timing, silence, and black-box constraints all matter.",
    tags: ["EOS", "FOCUS", "CUE TIMING"],
    selectedProjects: ["POING", "DANSENS HUS", "BLACK BOX THEATER"],
    metadata: {
      years: "CONTEMPORARY PRODUCTIONS",
      location: "NORWAY / EUROPE",
      role: "DANCE LIGHTING DESIGNER",
      proof: ["BLACK-BOX SPACES", "MOVEMENT-LED TIMING", "REPERTORY REMOUNTS"]
    },
    image: "/images/portfolio/dance/cover.jpg",
    href: "/portfolio/contemporary-dance-lighting/",
    cta: "DISCUSS DANCE WORK",
    tone: "warm",
    layout: "standard"
  },
  {
    title: "FESTIVAL ADAPTATION",
    slug: "festival-work",
    description: "Fast calls under pressure: short changeovers, daylight problems, patched rigs, and touring ideas rebuilt quickly for the local stage.",
    tags: ["BUSKING", "LOCAL PLOTS", "SHOW-DAY FIXES"],
    selectedProjects: ["EUROPAVOX", "ROCKEFELLER", "PARKTEATRET"],
    metadata: {
      years: "MULTIPLE SEASONS",
      location: "NORDICS / EUROPE",
      role: "FESTIVAL OPERATOR / PROGRAMMER",
      proof: ["SHORT CHANGEOVERS", "DAYLIGHT ADAPTATION", "LOCAL RIG TRANSLATION"]
    },
    image: "/images/portfolio/festival/cover.jpg",
    href: "/portfolio/festival-venue-adaptation/",
    cta: "PLAN FESTIVAL VERSION",
    tone: "cyan",
    layout: "standard"
  },
  {
    title: "VISUAL DIRECTION",
    slug: "artist-collaboration",
    description: "Working with artists and directors to turn references into lighting systems. Rehearsals, iteration, and choices that balance taste with what the room can actually do.",
    tags: ["REFERENCES", "REHEARSALS", "CUEING"],
    selectedProjects: ["JAIN", "TIM DUP", "LAFAYETTE REGENCY"],
    metadata: {
      years: "Ongoing",
      location: "Oslo / touring rooms",
      role: "ARTIST COLLABORATION",
      proof: ["ARTIST-LED PROCESS", "REHEARSALS", "ITERATION", "VISUAL LANGUAGE", "TECHNICAL EXECUTION"]
    },
    image: "/images/portfolio/artist/cover.jpg",
    cta: "ARTIST PROJECTS",
    tone: "neutral",
    layout: "standard"
  },
  {
    title: "Unreal Visualization",
    slug: "unreal-visualization",
    description: "Using 3D as a practical production tool: test lighting ideas before the venue, build stage environments, check camera angles, and prepare visual direction for shows, clips, and live concepts.",
    tags: ["UNREAL ENGINE", "CAPTURE", "CARBON"],
    selectedProjects: ["DREAM VENUE", "CONCERT PREVIS", "VIRTUAL STAGE DESIGN"],
    metadata: {
      years: "Preproduction",
      location: "Studio / remote",
      role: "PREVIS / 3D LIGHTING",
      proof: ["REAL-TIME PREVIS", "STAGE ENVIRONMENTS", "CAMERA ANGLES", "LIGHTING CONCEPTS", "SHOW PREPARATION"]
    },
    image: "/images/portfolio/unreal/cover.jpg",
    cta: "PREVIS WORKFLOW",
    tone: "warm",
    layout: "standard"
  },
  {
    title: "SPECIAL PROJECTS",
    slug: "special-projects",
    description: "Unusual venues, hybrid productions, and technical experiments where normal workflows do not exist. Combining light, video, streaming, control, and practical problem-solving.",
    tags: ["VIDEO", "INTERACTIVE", "CUSTOM WORKFLOWS"],
    selectedProjects: ["STREAMING SETUPS", "INTERACTIVE WORK", "IMMERSIVE PROJECTS"],
    metadata: {
      years: "Selected builds",
      location: "Venues / studios / hybrid",
      role: "HYBRID / EXPERIMENTAL WORK",
      proof: ["INSTALLATIONS", "STREAMING", "HYBRID SETUPS", "EXPERIMENTATION", "TECHNICAL DEVELOPMENT"]
    },
    image: "/images/portfolio/special/cover.jpg",
    cta: "SPECIAL PROJECTS",
    tone: "neutral",
    layout: "compact"
  }
];
---

<Layout
  title="Portfolio | De Freitas Lys Design"
  description="Selected lighting design, programming, touring, festival, contemporary dance, and visualization work by Dorian De Freitas."
>
  <div class="glow"></div>

  <main class="portfolio-page">
    <section class="portfolio-hero" aria-labelledby="portfolio-title">
      <PageLabelBar label="Portfolio" />

      <h1 id="portfolio-title">Selected Work &amp; Case Studies</h1>

      <p>
        Touring systems, artist-led looks, contemporary dance, festivals, visualization, and
        case studies from live production rooms that need practical decisions fast.
      </p>

      <div class="hero-actions" aria-label="Portfolio actions">
        <a class="cta" href="/contact/">Start a Project</a>
        <a class="cta cta-secondary" href="/services/">Services</a>
      </div>
    </section>

    <section class="portfolio-grid" aria-label="Selected portfolio projects">
      {
        projects.map((project) => (
          <article
            class={`portfolio-card portfolio-card--${project.tone} portfolio-card--${project.layout}`}
            data-project={project.slug}
          >
            <PortfolioImage image={project.image} alt={`${project.title} project image`} />

            <div class="portfolio-card-body">
              <span class="portfolio-category">{project.metadata.role}</span>
              <h2>{project.title}</h2>
              <p>{project.description}</p>

              <div class="portfolio-proof">
                <ul>
                  <li>{project.metadata.years}</li>
                  <li>{project.metadata.location}</li>
                  {project.metadata.proof.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>

              <div class="portfolio-meta">
                <div>
                  <span>Scope</span>
                  <ul>
                    {project.tags.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>

                <div>
                  <span>Selected Projects</span>
                  <ul>
                    {project.selectedProjects.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <a class="portfolio-link" href={project.href ?? "/contact/"}>
                {project.cta}
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <section class="services-cta portfolio-cta" aria-labelledby="portfolio-contact-title">
      <div>
        <div class="section-kicker">Next Step</div>
        <h2 id="portfolio-contact-title">Send the room, the dates, and the problem.</h2>
      </div>

      <div class="hero-actions" aria-label="Portfolio contact actions">
        <a class="cta" href="/contact/">Start a Project</a>
        <a class="cta cta-secondary" href="/services/">Discuss Workflow</a>
      </div>
    </section>
  </main>
</Layout>
