---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
import PortfolioImage from "../components/PortfolioImage.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("portfolio", ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Portfolio | De Freitas Lys Design"
  description="Selected lighting design, programming, touring, festival, contemporary dance, and visualization work by Dorian De Freitas."
>
  <div class="glow"></div>

  <main class="portfolio-page" id="main-content">
    <section class="portfolio-hero" aria-labelledby="portfolio-title">
      <PageLabelBar label="Portfolio" />

      <h1 id="portfolio-title">Selected Work &amp; Case Studies</h1>

      <p>
        Touring systems, artist-led looks, contemporary dance, festivals, visualization, and
        case studies from live production rooms that need practical decisions fast.
      </p>

      <div class="hero-actions" aria-label="Portfolio actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/services/">View Services</a>
      </div>
    </section>

    <section class="portfolio-grid" aria-label="Selected portfolio projects">
      {
        projects.map((project, index) => (
          <article
            class={`portfolio-card portfolio-card--${project.data.format === "Dance" || project.data.format === "Previsualization" ? "warm" : project.data.format === "Touring" || project.data.format === "Festival" ? "cyan" : "neutral"} portfolio-card--${project.data.order === 1 ? "feature" : project.data.format === "Special Project" ? "compact" : "standard"}`}
            data-project={project.id}
          >
            <PortfolioImage
              image={project.data.cover}
              alt={`${project.data.title}: ${project.data.coverAlt}`}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : undefined}
            />

            <div class="portfolio-card-body">
              <span class="portfolio-category">{project.data.role}</span>
              <h2>{project.data.title}</h2>
              <p>{project.data.description}</p>

              <div class="portfolio-proof">
                <ul>
                  <li>{project.data.year}</li>
                  <li>{project.data.location}</li>
                  {[project.data.productionProblem, project.data.changedOnSite, project.data.stayedConsistent].filter(Boolean).map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>

              <div class="portfolio-meta">
                <div>
                  <span>Scope</span>
                  <ul>
                    {project.data.tags.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>

                <div>
                  <span>Selected Projects</span>
                  <ul>
                    {project.data.selectedProjects.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <dl class="portfolio-case-notes" aria-label={`${project.data.title} case study summary`}>
                <div>
                  <dt>Context</dt>
                  <dd>{project.data.truth ?? project.data.format}</dd>
                </div>
                <div>
                  <dt>Constraints</dt>
                  <dd>{project.data.productionProblem ?? project.data.challenge}</dd>
                </div>
                <div>
                  <dt>System / Console</dt>
                  <dd>{project.data.systems.join(" / ")}</dd>
                </div>
                <div>
                  <dt>Result</dt>
                  <dd>{project.data.result}</dd>
                </div>
                <div>
                  <dt>Visuals</dt>
                  <dd>{project.data.coverAlt}</dd>
                </div>
              </dl>

              <a class="portfolio-link" href={`/portfolio/${project.id}/`} data-track-event="portfolio_case_study_click" data-astro-prefetch>
                {project.data.order === 1 ? "Touring Case Study" : project.data.format === "Dance" ? "Dance Case Study" : project.data.format === "Festival" ? "Festival Case Study" : "View Case Study"}
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <section class="services-cta portfolio-cta" aria-labelledby="portfolio-contact-title">
      <div>
        <div class="section-kicker">Next Step</div>
        <h2 id="portfolio-contact-title">Send the room, the dates, and the problem.</h2>
      </div>

      <div class="hero-actions" aria-label="Portfolio contact actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/services/">View Services</a>
      </div>
    </section>
  </main>
</Layout>
