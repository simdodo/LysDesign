---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
---

<Layout
  title="Contact | De Freitas Lys Design"
  description="Send project details to De Freitas Lys Design for lighting design, programming, touring, previs, streaming, and special live production work."
>
  <main class="contact-page" id="main-content">
    <section class="contact-hero" aria-labelledby="contact-title">
      <PageLabelBar label="Contact" />

      <h1 id="contact-title">Start a Project</h1>

      <p>
        Send the project brief, venue, dates, console or system information, and references.
        I will help make the plan workable before it becomes an expensive problem on site.
      </p>

      <div class="hero-actions" aria-label="Contact page actions">
        <a class="cta btn-primary" href="#project-contact-form" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">View Portfolio</a>
      </div>
    </section>

    <section class="contact-shell" id="project-contact-form" aria-label="Project contact form">
      <form
        class="contact-form"
        id="contact-form"
        name="project-inquiry"
        action="https://formsubmit.co/hello@defreitaslysdesign.com"
        method="post"
        data-track-event="contact_form_submit"
      >
        <input type="text" name="_honey" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="New De Freitas Lys Design project inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://defreitaslysdesign.com/contact/?sent=true" />

        <p class="form-status" data-form-status hidden>
          Message sent. I will come back to you as soon as possible.
        </p>

        <div class="form-grid">
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>

        <label>
          <span>Company / Artist / Production</span>
          <input type="text" name="production" autocomplete="organization" />
        </label>

        <label>
          <span>Project type</span>
          <select name="project_type" required>
            <option value="">Select one</option>
            <option>Lighting Design</option>
            <option>Programming / Operator</option>
            <option>Touring / Live Event</option>
            <option>Dance / Theatre</option>
            <option>Unreal / Previs</option>
            <option>Streaming / Camera Lighting</option>
            <option>Special Project</option>
          </select>
        </label>

        <div class="form-grid">
          <label>
            <span>Dates</span>
            <input type="text" name="dates" placeholder="Show day, rehearsals, load-in" />
          </label>

          <label>
            <span>Location / Venue</span>
            <input type="text" name="location" autocomplete="address-level2" />
          </label>
        </div>

        <label>
          <span>Console / System if known</span>
          <input type="text" name="console_system" placeholder="GrandMA, EOS, local desk, unknown" />
        </label>

        <label>
          <span>Message / Brief</span>
          <textarea name="message" rows="8" placeholder="What is confirmed, what is missing, and where the pressure is." required></textarea>
        </label>

        <button class="cta btn-primary" type="submit">Send Project Details</button>

        <p class="contact-fallback">
          Prefer email?
          <a href="mailto:hello@defreitaslysdesign.com" data-track-event="contact_email_click">hello@defreitaslysdesign.com</a>
        </p>
      </form>

      <aside class="contact-details" aria-labelledby="useful-details-title">
        <h2 id="useful-details-title">Useful details to include</h2>
        <ul>
          <li>artist / production</li>
          <li>dates</li>
          <li>venue size</li>
          <li>existing rig</li>
          <li>console</li>
          <li>deadline</li>
          <li>references</li>
          <li>what is still unknown</li>
        </ul>
      </aside>
    </section>
  </main>
</Layout>

<script is:inline>
  (() => {
    const status = document.querySelector("[data-form-status]");
    const params = new URLSearchParams(window.location.search);
    if (status && params.get("sent") === "true") {
      status.hidden = false;
    }
  })();
</script>
