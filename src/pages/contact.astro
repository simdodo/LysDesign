---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact | De Freitas Lys Design"
  description="Contact De Freitas Lys Design for lighting design, show programming, touring, and creative technology work."
>
  <main class="contact-page">
    <section class="contact-shell" aria-labelledby="contact-title">
      <div class="section-kicker">Contact</div>

      <h1 id="contact-title">Build the next visual system.</h1>

      <p>
        For concerts, touring, programming, or visual direction enquiries, send project details,
        timeline, location, and the level of production support required.
      </p>

      <a class="cta" href="mailto:hello@defreitaslys.design">
        hello@defreitaslys.design
      </a>
    </section>
  </main>
</Layout>
