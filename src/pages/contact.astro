---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
---

<Layout
  title="Contact Dorian De Freitas | Lighting Projects"
  description="Send project details for lighting design, programming, touring, festival, dance or previs work with De Freitas Lys Design in Oslo."
>
  <main class="contact-page" id="main-content">
    <section class="contact-hero" aria-labelledby="contact-title">
      <PageLabelBar label="ADVANCE BRIEF" />

      <h1 id="contact-title">Start a Project</h1>

      <p>
        Send the project brief, venue, dates, console or system information, and references.
        Incomplete briefs are fine. I will help make the plan workable before it becomes an
        expensive problem on site.
      </p>

      <div class="hero-actions" aria-label="Contact page actions">
        <a class="cta btn-primary" href="#project-contact-form" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">View Portfolio</a>
      </div>
    </section>

    <section class="contact-next-steps" aria-labelledby="contact-next-title">
      <div>
        <h2 id="contact-next-title">What happens next</h2>
        <p>
          I usually reply within 1-2 working days. If the project is urgent, include the show
          date, load-in time and the decision that has to be made first.
        </p>
      </div>

      <div>
        <h2>Incomplete briefs are fine</h2>
        <p>
          You do not need a finished technical package. Send what exists now: a rough brief,
          venue name, references, confirmed dates or even the unknowns.
        </p>
      </div>
    </section>

    <section class="contact-shell" id="project-contact-form" aria-label="Project contact form">
      <form
        class="contact-form"
        id="contact-form"
        name="project-inquiry"
        action="https://formsubmit.co/hello@defreitaslysdesign.com"
        method="post"
        data-track-event="contact_form_submit"
        aria-describedby="form-status contact-fallback"
      >
        <input type="text" name="_honey" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="New De Freitas Lys Design project inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://defreitaslysdesign.com/contact/?sent=true" />

        <p class="form-status" id="form-status" data-form-status hidden aria-live="polite">
          Message sent. I will come back to you as soon as possible.
        </p>

        <fieldset class="form-fieldset">
          <legend>Production</legend>

          <div class="form-grid">
            <label for="contact-name">
              <span>Name</span>
              <input id="contact-name" type="text" name="name" autocomplete="name" required />
            </label>

            <label for="contact-email">
              <span>Email</span>
              <input id="contact-email" type="email" name="email" autocomplete="email" required />
            </label>
          </div>

          <label for="contact-production">
            <span>Company / Artist / Production</span>
            <input id="contact-production" type="text" name="production" autocomplete="organization" />
          </label>

          <label for="contact-project-type">
            <span>Project type</span>
            <select id="contact-project-type" name="project_type" required>
              <option value="">Select one</option>
              <option>Lighting Design</option>
              <option>Programming / Operator</option>
              <option>Touring / Live Event</option>
              <option>Dance / Theatre</option>
              <option>Unreal / Previs</option>
              <option>Streaming / Camera Lighting</option>
              <option>Special Project</option>
            </select>
          </label>
        </fieldset>

        <fieldset class="form-fieldset">
          <legend>Date / Room</legend>

          <div class="form-grid">
            <label for="contact-dates">
              <span>Dates</span>
              <input id="contact-dates" type="text" name="dates" placeholder="Show day, rehearsals, load-in" />
            </label>

            <label for="contact-location">
              <span>Location / Venue</span>
              <input id="contact-location" type="text" name="location" autocomplete="address-level2" />
            </label>
          </div>
        </fieldset>

        <fieldset class="form-fieldset">
          <legend>System / Unknowns</legend>

          <label for="contact-console-system">
            <span>Console / System if known</span>
            <input id="contact-console-system" type="text" name="console_system" placeholder="GrandMA, EOS, local desk, unknown" />
          </label>

          <label for="contact-message">
            <span>Message / Brief</span>
            <textarea id="contact-message" name="message" rows="8" placeholder="What is confirmed, what is missing, and where the pressure is." required></textarea>
          </label>
        </fieldset>

        <button class="cta btn-primary" type="submit">Send Project Details</button>

        <p class="contact-fallback" id="contact-fallback">
          If the form fails, or the brief is easier by email:
          <a href="mailto:hello@defreitaslysdesign.com" data-track-event="contact_email_click">hello@defreitaslysdesign.com</a>
        </p>
      </form>

      <aside class="contact-details" aria-labelledby="useful-details-title">
        <h2 id="useful-details-title">Useful details to include</h2>
        <ul>
          <li>artist / production</li>
          <li>dates</li>
          <li>venue size</li>
          <li>existing rig</li>
          <li>console</li>
          <li>deadline</li>
          <li>references</li>
          <li>what is still unknown</li>
        </ul>
      </aside>
    </section>
  </main>
</Layout>

<script is:inline>
  (() => {
    const status = document.querySelector("[data-form-status]");
    const params = new URLSearchParams(window.location.search);
    if (status && params.get("sent") === "true") {
      status.hidden = false;
    }
  })();
</script>
