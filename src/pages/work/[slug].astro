---
import Base from '../../layouts/Base.astro';
import CasePage from '../../components/CasePage.astro';
import { work, type WorkEntry } from '../../data/work';

export function getStaticPaths() {
  return work.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const c = entry.copy.en;
---

<Base
  locale="en"
  title={`${c.title} — Dorian De Freitas, lighting designer`}
  description={c.paragraphs[0]}
  path={`/work/${entry.slug}/`}
>
  <CasePage locale="en" entry={entry} />
</Base>
