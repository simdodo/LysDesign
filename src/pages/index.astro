---
import Layout from "../layouts/Layout.astro";
import CinematicHero from "../components/CinematicHero.astro";
import WhatBreaksAShow from "../components/WhatBreaksAShow.astro";
import ServiceTeaser from "../components/ServiceTeaser.astro";
import CueSequence from "../components/CueSequence.astro";
import SelectedWork from "../components/SelectedWork.astro";
import FinalCTA from "../components/FinalCTA.astro";
import BlackoutBreak from "../components/BlackoutBreak.astro";
import festivalHeroImage from "../assets/portfolio/festival/cover.jpg";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

const credibility = [
  "16+ years experience",
  "Oslo / Norway / Europe",
  "Concerts / dance / festivals",
  "GrandMA / EOS / Unreal",
  "JAIN / Tim Dup / POING"
];

const productions = [
  "International Touring",
  "Contemporary Dance",
  "Festival Productions",
  "Venue Programming",
  "Live Operation",
  "Previsualization"
];

const services = [
  {
    title: "Touring",
    description: "Showfiles, versions, local crew adaptation, and systems that still work when the room changes.",
    cta: "Touring support",
    href: "/services/touring-showfiles/"
  },
  {
    title: "Dance",
    description: "Cue timing, focus, silence, and black-box constraints built with performers in rehearsal.",
    cta: "Dance lighting",
    href: "/services/dance-theatre-lighting/"
  },
  {
    title: "Festival",
    description: "Fast changeovers, daylight problems, patched rigs, and practical show-day decisions.",
    cta: "Festival versioning",
    href: "/services/festival-lighting/"
  },
  {
    title: "Visualization",
    description: "Unreal and previs workflows for testing ideas before the venue becomes the first draft.",
    cta: "Previs workflow",
    href: "/services/unreal-previs/"
  }
];

const process = [
  {
    title: "Understand the room",
    description: "Start with the venue, rig, schedule, crew, cameras, and what is already locked."
  },
  {
    title: "Build the system",
    description: "Make a plan that can be programmed, toured, adapted, and explained under pressure."
  },
  {
    title: "Adapt on site",
    description: "Keep the look intact when fixtures move, time disappears, or the local plot is different."
  }
];

const featuredProjects = (await getCollection("portfolio", ({ data }) => data.published && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const heroImageWidths = [768, 1024, 1280, 1600, 1920];
const heroPreloadSources = await Promise.all(
  heroImageWidths.map((width) =>
    getImage({
      src: festivalHeroImage,
      width,
      format: "avif"
    })
  )
);
const heroPreloadImage = {
  href: heroPreloadSources.at(-1)?.src,
  srcset: heroPreloadSources
    .map((source, index) => `${source.src} ${heroImageWidths[index]}w`)
    .join(", "),
  sizes: "100vw",
  type: "image/avif"
};
---

<Layout
  title="De Freitas Lys Design | Lighting Design for Live Production"
  description="Lighting design, programming, touring/live production systems and previs for concerts, dance and festivals in Oslo, Norway and across Europe."
  preloadImage={heroPreloadImage}
>
  <div class="glow"></div>

  <main id="main-content">
    <CinematicHero
      title="LIGHT THAT SURVIVES THE ROOM."
      subtitle="Lighting design, programming and touring/live production systems for concerts, dance and festivals in Oslo, Norway and across Europe."
      image={festivalHeroImage}
      imageAlt="Festival crowd and lighting console under cyan stage beams"
      proofPoints={credibility}
    />

    <WhatBreaksAShow productions={productions} />

    <ServiceTeaser services={services} />

    <BlackoutBreak text="The best cue is often the one that gives the room back to the artist." />

    <CueSequence cues={process} />

    <section class="home-section home-about" aria-labelledby="home-about-title">
      <div class="section-kicker">ABOUT</div>
      <div>
        <h2 id="home-about-title">Systems, showfiles, and live decisions.</h2>
        <p>
          I design lighting systems, showfiles, touring workflows, and practical solutions for
          productions that need to work outside ideal conditions.
        </p>
      </div>

      <div class="section-actions section-actions--quiet" aria-label="About actions">
        <a class="link-tertiary" href="/about/">Read the working approach</a>
      </div>
    </section>

    <SelectedWork projects={featuredProjects} />

    <FinalCTA />
  </main>
</Layout>
