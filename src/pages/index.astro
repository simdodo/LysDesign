---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
import PortfolioImage from "../components/PortfolioImage.astro";
import festivalImage from "../assets/portfolio/festival/cover.jpg";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import "../styles/home.css";

const portfolioProjects = await getCollection("portfolio", ({ data }) => data.published);
const projectMap = new Map(portfolioProjects.map((project) => [project.id, project]));
const selectedProjectIds = [
  "touring-lighting-showfiles",
  "contemporary-dance-lighting",
  "festival-venue-adaptation",
  "unreal-visualization"
];
const selectedProjects = selectedProjectIds.flatMap((id) => {
  const project = projectMap.get(id);
  return project ? [project] : [];
});

const breakPoints = [
  {
    problem: "The rig changed.",
    response: "Adapt the system."
  },
  {
    problem: "Rehearsal time got shorter.",
    response: "Protect the rhythm."
  },
  {
    problem: "The room killed the original look.",
    response: "Keep the identity."
  },
  {
    problem: "The artist still needs to feel like themselves.",
    response: "Make it work live."
  }
];

const systems = [
  {
    label: "GrandMA",
    detail: "Touring showfiles, live programming and festival versions."
  },
  {
    label: "EOS",
    detail: "Cue timing, focus and theatre / dance environments."
  },
  {
    label: "Unreal / previs",
    detail: "Stage environments before the room sets the limits."
  },
  {
    label: "Touring systems / showfiles",
    detail: "Readable systems that can move between rooms and crews."
  }
];

const process = [
  {
    step: "Understand the room.",
    detail: "Start with the venue, rig, time, crew and unknowns."
  },
  {
    step: "Build the system.",
    detail: "Make the file and workflow readable before pressure arrives."
  },
  {
    step: "Adapt on site.",
    detail: "Translate the idea when the room or plot changes."
  },
  {
    step: "Keep the show recognizable.",
    detail: "Protect the artist picture through practical decisions."
  }
];

const proofPoints = [
  "16+ years in live entertainment",
  "Oslo based",
  "Norway / Europe",
  "Concerts / dance / festivals",
  "Lighting design / programming / operation"
];

const heroImageWidths = [768, 1024, 1280, 1600, 1920];
const heroPreloadSources = await Promise.all(
  heroImageWidths.map((width) =>
    getImage({
      src: festivalImage,
      width,
      format: "avif"
    })
  )
);
const heroPreloadImage = {
  href: heroPreloadSources.at(-1)?.src,
  srcset: heroPreloadSources
    .map((source, index) => `${source.src} ${heroImageWidths[index]}w`)
    .join(", "),
  sizes: "100vw",
  type: "image/avif"
};
---

<Layout
  title="De Freitas Lys Design | Lighting Design & Programming"
  description="Lighting design, programming and touring systems for concerts, dance, festivals and live productions — based in Oslo, working across Norway and Europe."
  image="/images/portfolio/festival/cover.jpg"
  preloadImage={heroPreloadImage}
>
  <main class="home" id="main-content">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-media" aria-hidden="true">
        <PortfolioImage
          image={festivalImage}
          alt="Festival lighting and crowd seen from a production perspective"
          loading="eager"
          fetchpriority="high"
          widths={[768, 1024, 1280, 1600, 1920]}
          sizes="100vw"
          caption="Festival / room pressure / live system"
        />
      </div>

      <div class="home-hero-content">
        <PageLabelBar label="BLACKOUT / UV SIGNAL" description="Live systems / room pressure" />
        <h1 id="home-title">
          <span>LIGHT THAT</span>
          <span>SURVIVES</span>
          <span>THE ROOM.</span>
        </h1>
        <p>
          Lighting design, programming and touring systems for concerts, dance,
          festivals and live productions — based in Oslo, working across Norway
          and Europe.
        </p>

        <div class="hero-actions" aria-label="Home actions">
          <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
          <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">View Work</a>
        </div>
      </div>
    </section>

    <section class="home-work" aria-labelledby="home-work-title">
      <div class="section-kicker">Selected Work</div>
      <h2 id="home-work-title">Work that has to hold under pressure.</h2>

      <div class="home-work-grid">
        {selectedProjects.map((project) => (
          <a href={`/portfolio/${project.id}/`} data-track-event="portfolio_case_study_click">
            <PortfolioImage
              image={project.data.cover}
              alt={project.data.coverAlt}
              caption={`${project.data.format} / ${project.data.role}`}
            />
            <span>{project.data.title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-breaks" aria-labelledby="home-breaks-title">
      <div class="section-kicker">What Breaks A Show</div>
      <h2 id="home-breaks-title">Pressure first. Service name second.</h2>

      <div class="home-break-grid">
        {breakPoints.map((item) => (
          <article>
            <span>{item.problem}</span>
            <strong>{item.response}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="home-systems" aria-labelledby="home-systems-title">
      <div>
        <div class="section-kicker">Technical systems</div>
        <h2 id="home-systems-title">Tools are only useful when the room is honest.</h2>
      </div>

      <ul>
        {systems.map((system) => (
          <li>
            <span>{system.label}</span>
            <p>{system.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-process" aria-labelledby="home-process-title">
      <div class="section-kicker">Process</div>
      <h2 id="home-process-title">Make the show readable before show day.</h2>

      <ol>
        {process.map((step) => (
          <li>
            <span>{step.step}</span>
            <p>{step.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-proof" aria-labelledby="home-proof-title">
      <div class="section-kicker">Proof</div>
      <h2 id="home-proof-title">Built from real rooms, not ideal diagrams.</h2>

      <ul>
        {proofPoints.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </section>

    <section class="home-final" aria-labelledby="home-final-title">
      <h2 id="home-final-title">Bring the brief, the room and the deadline.</h2>
      <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
    </section>
  </main>
</Layout>
