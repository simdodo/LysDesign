---
import Layout from "../layouts/Layout.astro";
import CinematicHero from "../components/CinematicHero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import WhatBreaksAShow from "../components/WhatBreaksAShow.astro";
import ServiceTeaser from "../components/ServiceTeaser.astro";
import ProductionTimeline from "../components/ProductionTimeline.astro";
import SelectedWork from "../components/SelectedWork.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getCollection } from "astro:content";

const credibility = [
  "16+ years experience",
  "International touring",
  "Dance / festivals / music",
  "GrandMA / EOS / Unreal",
  "Oslo based + international"
];

const productions = [
  "International Touring",
  "Contemporary Dance",
  "Festival Productions",
  "Venue Programming",
  "Live Operation",
  "Previsualization"
];

const services = [
  {
    title: "Touring",
    description: "Showfiles, versions, local crew adaptation, and systems that still work when the room changes.",
    cta: "Touring support",
    href: "/services/"
  },
  {
    title: "Dance",
    description: "Cue timing, focus, silence, and black-box constraints built with performers in rehearsal.",
    cta: "Dance lighting",
    href: "/services/"
  },
  {
    title: "Festival",
    description: "Fast changeovers, daylight problems, patched rigs, and practical show-day decisions.",
    cta: "Festival versioning",
    href: "/services/"
  },
  {
    title: "Visualization",
    description: "Unreal and previs workflows for testing ideas before the venue becomes the first draft.",
    cta: "Previs workflow",
    href: "/services/"
  }
];

const process = [
  {
    title: "Understand the room",
    description: "Start with the venue, rig, schedule, crew, cameras, and what is already locked."
  },
  {
    title: "Build a workable system",
    description: "Make a plan that can be programmed, toured, adapted, and explained under pressure."
  },
  {
    title: "Adapt on site",
    description: "Keep the look intact when fixtures move, time disappears, or the local plot is different."
  }
];

const featuredProjects = (await getCollection("portfolio", ({ data }) => data.published && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Layout
  title="De Freitas Lys Design | Lighting Design for Live Production"
  description="Lighting design, programming, touring systems and previs for concerts, dance, festivals and live productions across Norway and Europe."
  preloadImage="/images/portfolio/festival/cover.jpg"
>
  <div class="glow"></div>

  <main id="main-content">
    <CinematicHero
      title="LIGHT THAT SURVIVES THE ROOM."
      subtitle="Lighting design, programming and touring systems for concerts, dance, festivals and live productions across Norway and Europe."
      image="/images/portfolio/festival/cover.jpg"
      imageAlt="Festival crowd and lighting console under cyan stage beams"
    />

    <ProofStrip items={credibility} />

    <WhatBreaksAShow productions={productions} />

    <ServiceTeaser services={services} />

    <ProductionTimeline process={process} />

    <section class="home-section home-about" aria-labelledby="home-about-title">
      <div class="section-kicker">ABOUT</div>
      <div>
        <h2 id="home-about-title">Systems, showfiles, and live decisions.</h2>
        <p>
          I design lighting systems, showfiles, touring workflows, and practical solutions for
          productions that need to work outside ideal conditions.
        </p>
      </div>

      <div class="section-actions" aria-label="About actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/about/">About</a>
      </div>
    </section>

    <SelectedWork projects={featuredProjects} />

    <FinalCTA />
  </main>
</Layout>
