---
import Layout from "../layouts/Layout.astro";
import SelectedWork from "../components/SelectedWork.astro";
---

<Layout
  title="De Freitas Lys Design | Lighting Design"
  description="Lighting design, programming, and creative technology for concerts, touring, and live performance across Europe."
>
  <div class="glow"></div>

  <main>
    <section class="container hero-section" aria-labelledby="hero-title">
      <div class="hero">
        <div class="hero-small">
          DE FREITAS LYS DESIGN
        </div>

        <h1 id="hero-title">
          LIGHT
          <span>SHAPES</span>
          EMOTION
        </h1>

        <p>
          Lighting Designer &middot; Programmer &middot; Creative Technologist
        </p>

        <p>
          Concerts &middot; Touring &middot; Art Direction &middot; Oslo / Europe
        </p>

        <a class="cta" href="/contact">
          Let's Build Something
        </a>
      </div>
    </section>

    <SelectedWork />
  </main>
</Layout>
