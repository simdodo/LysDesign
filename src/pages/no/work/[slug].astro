---
import Base from '../../../layouts/Base.astro';
import CasePage from '../../../components/CasePage.astro';
import { work, type WorkEntry } from '../../../data/work';

export function getStaticPaths() {
  return work.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: WorkEntry;
}

const { entry } = Astro.props;
const c = entry.copy.no;
---

<Base
  locale="no"
  title={`${c.title} — Dorian De Freitas, lysdesigner`}
  description={c.paragraphs[0]}
  path={`/work/${entry.slug}/`}
>
  <CasePage locale="no" entry={entry} />
</Base>
