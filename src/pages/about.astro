---
import Layout from "../layouts/Layout.astro";

const experience = [
  "16+ years in live entertainment, concerts, touring and stage lighting",
  "Experience across Norway, France, Europe and international touring contexts",
  "Work connected to concerts, contemporary dance, festivals, clubs, venues and artist-led productions",
  "Tools and workflows: GrandMA2, GrandMA3, ETC Eos, Chamsys, Vista, Capture, Vectorworks, Unreal Engine and Blender"
];

const principles = [
  {
    title: "Practical first",
    kicker: "Room / rig / crew",
    copy: "Lighting has to work in the room, with the rig, crew, schedule and constraints that actually exist."
  },
  {
    title: "Artistic but reliable",
    kicker: "Visual system",
    copy: "The visual idea matters, but the system behind it must be clear, repeatable and easy to adapt."
  },
  {
    title: "Calm under pressure",
    kicker: "Show day",
    copy: "Live production often means short changeovers, last-minute changes and imperfect information. The workflow must stay readable."
  },
  {
    title: "Built for adaptation",
    kicker: "Touring / festivals",
    copy: "Touring, festivals and guest operator situations need showfiles and lighting decisions that can travel between different rooms."
  }
];

const productionValue = [
  "lighting design and visual direction",
  "showfile structure and programming",
  "console operation and live cueing",
  "touring and festival adaptation",
  "theatre and contemporary dance cue precision",
  "previs and visualization workflows when useful"
];
---

<Layout
  title="About Dorian De Freitas | Lighting Designer & Programmer in Oslo"
  description="About Dorian De Freitas, Oslo-based lighting designer, programmer and operator working across touring, contemporary dance, festivals, venues and live production."
>
  <div class="glow"></div>

  <main class="services-page">
    <section class="services-hero" aria-labelledby="about-title">
      <div class="section-kicker">WHO I AM</div>

      <h1 id="about-title">Lighting design, programming and live production for real show conditions.</h1>

      <p>
        I’m Dorian De Freitas, an Oslo-based lighting designer, programmer and operator working
        across touring, contemporary dance, festivals, venues and artist-led productions.
      </p>

      <p>
        My work sits between artistic direction and technical delivery: building lighting
        systems, showfiles and cue structures that can survive real rooms, short rehearsals,
        local rigs and production pressure.
      </p>

      <div class="hero-actions" aria-label="About actions">
        <a class="cta" href="/portfolio/">View Portfolio</a>
        <a class="cta cta-secondary" href="/contact/">Start a Project</a>
      </div>
    </section>

    <section class="services-proof" aria-labelledby="selected-experience-title">
      <div class="proof-block">
        <span>Selected experience</span>
        <h2 id="selected-experience-title">Work built across real production formats.</h2>
      </div>

      <div class="proof-block">
        <span>Proof</span>
        <ul>
          {experience.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

    </section>

    <section class="services-grid" aria-labelledby="how-i-work-title">
      <article class="service-card service-card--primary">
        <span>How I work</span>
        <h2 id="how-i-work-title">How I work</h2>
        <p>
          The process is practical, technical and artist-aware. It starts with the production
          conditions, then builds a lighting workflow that can be operated and adapted.
        </p>
      </article>

      {
        principles.map((item) => (
          <article class="service-card service-card--primary">
            <span>{item.kicker}</span>
            <h2>{item.title}</h2>
            <p>{item.copy}</p>
          </article>
        ))
      }
    </section>

    <section class="services-proof" aria-labelledby="production-value-title">
      <div class="proof-block">
        <span>What I bring to a production</span>
        <h2 id="production-value-title">Useful before load-in, not only during the show.</h2>
      </div>

      <div class="proof-block">
        <span>Scope</span>
        <ul>
          {productionValue.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="services-cta" aria-labelledby="about-oslo-title">
      <div>
        <div class="section-kicker">Based in Oslo, available internationally</div>
        <h2 id="about-oslo-title">Oslo base. International production logic.</h2>
      </div>

      <p>
        De Freitas Lys Design is based in Oslo and works with productions in Norway, Europe
        and international touring contexts. The focus is on projects that need both a strong
        visual identity and a practical technical workflow.
      </p>
    </section>

    <section class="services-cta" aria-labelledby="about-contact-title">
      <div>
        <div class="section-kicker">Next step</div>
        <h2 id="about-contact-title">Need a lighting workflow that works in the real world?</h2>
      </div>

      <p>
        Send the project brief, venue, dates, console/system information and references.
        I’ll help clarify what the production needs and how to approach it.
      </p>

      <div class="hero-actions" aria-label="About contact actions">
        <a class="cta" href="/contact/">Start a Project</a>
      </div>
    </section>
  </main>
</Layout>
