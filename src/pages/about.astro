---
import Layout from "../layouts/Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
import PortfolioImage from "../components/PortfolioImage.astro";
import fohImage from "../assets/portfolio/touring/cover.jpg";

const experience = [
  "Live production, touring days, festivals, venues, clubs and short rehearsals",
  "Work connected to concerts, contemporary dance, festivals and artist-led productions",
  "Lighting design, GrandMA programming, FOH operation and venue adaptation",
  "GrandMA2, MA3 in progress, Capture, plots, showfiles and live systems"
];

const principles = [
  {
    title: "Read the room first",
    kicker: "Room / rig / crew",
    copy: "Before trying to make it beautiful, I look at what the room, rig, crew and schedule actually allow."
  },
  {
    title: "Keep it playable",
    kicker: "Visual system",
    copy: "The visual idea matters, but the showfile behind it has to stay readable enough to operate and adapt."
  },
  {
    title: "Calm under pressure",
    kicker: "Show day",
    copy: "Short changeovers, last-minute changes and imperfect information are normal. The workflow still needs to stay calm."
  },
  {
    title: "Protect the image",
    kicker: "Touring / festivals",
    copy: "When a room changes the plan, the artist still needs to recognize the show."
  }
];

const productionValue = [
  "lighting design and controlled visual direction",
  "showfile structure and programming",
  "GrandMA programming and FOH operation",
  "touring and festival adaptation",
  "contemporary dance cue timing and focus",
  "Capture previs, plot drawing and preparation when useful"
];
---

<Layout
  title="About Dorian De Freitas | Lighting Designer Oslo"
  description="About Dorian De Freitas, Oslo-based lighting designer, GrandMA programmer and FOH operator for concerts, dance, festivals and live production."
>
  <div class="glow"></div>

  <main class="services-page about-page" id="main-content">
    <section class="services-hero" aria-labelledby="about-title">
      <PageLabelBar label="About" />

      <h1 id="about-title">About Dorian De Freitas</h1>

      <p>
        I am Dorian De Freitas, a French lighting designer, GrandMA programmer
        and FOH operator based in Oslo.
      </p>

      <p class="about-hero-secondary">
        I come from live production more than from theory: venues, festivals,
        touring days, short rehearsals, local rigs, changing plans, tired crews,
        good shows, bad rooms and fast decisions.
      </p>

    </section>

    <section class="services-proof" aria-labelledby="selected-experience-title">
      <div class="proof-block">
        <span>Selected experience</span>
        <h2 id="selected-experience-title">Somewhere between design and operation.</h2>
      </div>

      <div class="proof-block">
        <span>Proof</span>
        <ul>
          {experience.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

    </section>

    <section class="about-incarnation" aria-labelledby="about-room-title">
      <PortfolioImage
        image={fohImage}
        alt="Front of house lighting position with console and concert stage view"
        caption="FOH / reading the room before the showfile takes over."
      />

      <div>
        <div class="section-kicker">ROOM READ</div>
        <h2 id="about-room-title">I read the room before I light it.</h2>
        <p>
          Trim height, dark corners, crew rhythm, sightlines, silence and where the
          artist actually stands. The room usually tells you what will work before
          the console does.
        </p>
      </div>
    </section>

    <section class="services-grid" aria-labelledby="how-i-work-title">
      <article class="service-card service-card--primary">
        <span>How I work</span>
        <h2 id="how-i-work-title">How I work</h2>
        <p>
          Sometimes I create the visual direction. Sometimes I build the showfile.
          Sometimes I adapt an existing idea to the room we actually have.
          Sometimes I stand at FOH and make the show breathe in real time.
        </p>
      </article>

      {
        principles.map((item) => (
          <article class="service-card service-card--primary">
            <span>{item.kicker}</span>
            <h2>{item.title}</h2>
            <p>{item.copy}</p>
          </article>
        ))
      }
    </section>

    <section class="services-proof" aria-labelledby="production-value-title">
      <div class="proof-block">
        <span>What I bring to a production</span>
        <h2 id="production-value-title">Readable, playable and alive.</h2>
      </div>

      <div class="proof-block">
        <span>Scope</span>
        <ul>
          {productionValue.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="services-cta" aria-labelledby="about-oslo-title">
      <div>
        <div class="section-kicker">Based in Oslo, available internationally</div>
        <h2 id="about-oslo-title">Oslo base. International production logic.</h2>
      </div>

      <p>
        I like saturated color, controlled darkness, minimal theatrical images
        and the moment when a room finally starts to make sense.
      </p>
    </section>

    <section class="services-cta" aria-labelledby="about-contact-title">
      <div>
        <div class="section-kicker">Next step</div>
        <h2 id="about-contact-title">Need a lighting workflow that works in the real world?</h2>
      </div>

      <p>
        I am not trying to make lighting more complicated. I am trying to make
        it playable, readable and alive.
      </p>

      <div class="hero-actions" aria-label="About contact actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
      </div>
    </section>
  </main>
</Layout>
