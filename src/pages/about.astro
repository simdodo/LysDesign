---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About | De Freitas Lys Design"
  description="About Dorian De Freitas, lighting designer and programmer based in Oslo working across touring, dance, festivals, and live production."
>
  <div class="glow"></div>

  <main class="services-page">
    <section class="services-hero" aria-labelledby="about-title">
      <div class="section-kicker">WHO I AM</div>

      <h1 id="about-title">Lighting systems for real production conditions.</h1>

      <p>
        I design lighting systems, showfiles, touring workflows, and practical solutions for
        productions that need to work outside ideal conditions.
      </p>

      <div class="hero-actions" aria-label="About actions">
        <a class="cta" href="/contact">Contact</a>
        <a class="cta cta-secondary" href="/portfolio">View Portfolio</a>
      </div>
    </section>
  </main>
</Layout>
