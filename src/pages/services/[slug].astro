---
import Layout from "../../layouts/Layout.astro";
import PageLabelBar from "../../components/PageLabelBar.astro";
import { servicePages } from "../../data/service-pages";

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug }
  }));
}

const service = servicePages.find((item) => item.slug === Astro.params.slug);

if (!service) {
  throw new Error(`Unknown service page: ${Astro.params.slug}`);
}

const overview = service.overview ?? [];
const idealFor = service.idealFor ?? [];
const requiredInputs = service.requiredInputs ?? [];
const scope = service.details ?? [];
const process = service.process ?? [];
const deliverables = service.deliverables ?? [];
const caseStudies = service.caseStudies ?? [];
const faqs = service.faqs ?? [];
---

<Layout title={service.title} description={service.description}>
  <div class="glow"></div>

  <main class="services-page" id="main-content">
    <section class="services-hero" aria-labelledby="service-title">
      <PageLabelBar label={service.label} description="Service" />

      <h1 id="service-title">{service.h1}</h1>

      <p>{service.intro}</p>

      <div class="hero-actions" aria-label={`${service.label} actions`}>
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">View Portfolio</a>
      </div>
    </section>

    <section class="services-proof" aria-label={`${service.label} overview`}>
      <div class="proof-block">
        <span>When this is useful</span>
        {overview.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="proof-block">
        <span>Ideal for</span>
        <ul>
          {idealFor.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="services-proof" aria-label={`${service.label} requirements`}>
      <div class="proof-block">
        <span>Required inputs</span>
        <ul>
          {requiredInputs.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="proof-block">
        <span>Scope</span>
        <ul>
          {scope.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="services-grid" aria-label={`${service.label} process and deliverables`}>
      <article class="service-card service-card--primary">
        <span>Process</span>
        <h2>How the work usually moves.</h2>
        <ul>
          {process.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="service-card service-card--primary">
        <span>Deliverables</span>
        <h2>What the production can use.</h2>
        <ul>
          {deliverables.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="service-card service-card--primary">
        <span>Relevant work</span>
        <h2>Case studies connected to this service.</h2>
        <p>
          These pages show the kind of production conditions, constraints and workflows this
          service is built around.
        </p>
        <ul>
          {caseStudies.map((caseStudy) => (
            <li><a href={caseStudy.href}>{caseStudy.label}</a></li>
          ))}
        </ul>
      </article>

      <article class="service-card service-card--primary">
        <span>FAQ</span>
        <h2>Common production questions.</h2>
        <ul>
          {faqs.map((item) => (
            <li><strong>{item.question}</strong> {item.answer}</li>
          ))}
        </ul>
      </article>
    </section>

    <section class="services-cta" aria-labelledby="service-contact-title">
      <div>
        <div class="section-kicker">Next Step</div>
        <h2 id="service-contact-title">Send the room, dates and what is unknown.</h2>
      </div>

      <p>
        Useful details include venue, existing rig, console, schedule, references and whether
        the production needs design, programming, operation or adaptation. Incomplete briefs
        are fine if the deadline and production context are clear.
      </p>

      <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
    </section>
  </main>
</Layout>
