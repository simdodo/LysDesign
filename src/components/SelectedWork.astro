---
import PortfolioImage from "./PortfolioImage.astro";

interface Project {
  id: string;
  data: {
    cover: unknown;
    coverAlt: string;
    format: string;
    role: string;
    year: string;
    title: string;
    description: string;
  };
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;

const linkLabels: Record<string, string> = {
  Touring: "Touring notes",
  Dance: "Dance notes",
  Festival: "Festival notes",
  Previsualization: "Previs notes",
  "Visual Direction": "Visual notes",
  "Special Project": "Project notes"
};
---

<section class="home-section" aria-labelledby="portfolio-preview-title">
  <div class="section-kicker">SELECTED WORK</div>
  <div class="portfolio-preview-divider">
    <h2 id="portfolio-preview-title">A few directions from the archive.</h2>
    <p>
      Touring, dance, festival, and previs work. More detail sits in the portfolio.
    </p>
  </div>

  <div class="home-portfolio-grid">
    {
      projects.map((project) => (
        <article class="home-portfolio-card">
          <PortfolioImage
            image={project.data.cover}
            alt={project.data.coverAlt}
            caption={`${project.data.format} / ${project.data.role} / ${project.data.year}`}
          />
          <div>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <a class="link-tertiary" href={`/portfolio/${project.id}/`} data-track-event="portfolio_case_study_click" data-astro-prefetch>
              {linkLabels[project.data.format] ?? "Case notes"}
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="section-actions section-actions--quiet" aria-label="Portfolio actions">
    <a class="link-tertiary" href="/portfolio/" data-track-event="cta_view_work">Open the showfile index</a>
  </div>
</section>
