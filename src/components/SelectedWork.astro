---
const projects = [
  {
    title: "Touring Systems",
    meta: "Arena scale / timecoded architecture",
    description: "Lighting states built for impact, repeatability, and fast show-day adaptation."
  },
  {
    title: "Concert Direction",
    meta: "Live music / visual dramaturgy",
    description: "High-contrast looks shaped around rhythm, negative space, and performer focus."
  },
  {
    title: "Creative Technology",
    meta: "Programming / control ecosystems",
    description: "Precise show files, fixture logic, and visual systems that hold under pressure."
  }
];
---

<section class="work-section" aria-labelledby="work-title">
  <div class="section-kicker">Selected Direction</div>

  <div class="section-heading">
    <h2 id="work-title">Designed for rooms that need to feel dangerous, clean, and alive.</h2>
    <p>
      De Freitas Lys Design creates lighting languages for live performance: stark beams,
      saturated atmospheres, brutal blackouts, and exact cue structures.
    </p>
  </div>

  <div class="work-grid">
    {
      projects.map((project) => (
        <article class="work-card">
          <span>{project.meta}</span>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </article>
      ))
    }
  </div>
</section>
