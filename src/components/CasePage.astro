---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LightEngine from './LightEngine.astro';
import ImagineReel from './ImagineReel.astro';
import { caseUi, type WorkEntry } from '../data/work';
import { pathForLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  entry: WorkEntry;
}

const { locale, entry } = Astro.props;
const c = entry.copy[locale];
const t = caseUi[locale];

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*/cover.jpg',
  { eager: true }
);
const cover = covers[`../assets/portfolio/${entry.image}/cover.jpg`]?.default;
---

<LightEngine />

<article class="case" data-light="proof">
  <p>
    <a class="back mono-label" href={pathForLocale(locale, '/') + '#work'}>← {t.back}</a>
  </p>

  <header>
    <p class="mono-label">{c.meta}</p>
    <h1>{c.title}</h1>
  </header>

  {
    entry.hasPreviz && cover ? (
      <ImagineReel locale={locale} realImage={cover} alt={entry.imageAlt} />
    ) : (
      cover && (
        <figure class="photo">
          <Image
            src={cover}
            alt={entry.imageAlt}
            widths={[640, 1080, 1600]}
            sizes="(max-width: 48rem) 100vw, 44rem"
          />
          <figcaption class="mono-label">{t.placeholderPhoto}</figcaption>
        </figure>
      )
    )
  }

  <div class="body">
    {c.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <aside class="cta" data-light="song">
    <span class="pilot" aria-hidden="true"></span>
    <p class="cta-title">{t.ctaTitle}</p>
    <a class="cta-button" href={pathForLocale(locale, '/') + '#send-a-song'}>{t.ctaButton}</a>
  </aside>
</article>

<style>
  .case {
    max-width: 44rem;
    margin: 0 auto;
    padding: 6rem var(--pad-x) 4rem;
  }

  .back {
    text-decoration: none;
    color: var(--gris-2);
  }

  .back:hover {
    color: var(--gris);
  }

  header {
    margin: 2.4rem 0 2rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
    margin-top: 0.8rem;
    text-wrap: balance;
  }

  .photo {
    margin: 2.6rem 0;
  }

  .photo img {
    border-radius: 8px;
    border: 1px solid var(--ligne);
  }

  .photo figcaption {
    margin-top: 0.5rem;
    color: var(--tungsten-dim);
  }

  .body p {
    color: var(--gris);
    font-size: 1.05rem;
    margin-bottom: 1.1rem;
    max-width: var(--measure);
  }

  .cta {
    margin-top: 4rem;
    padding: 3rem 1.5rem;
    border: 1px solid var(--ligne);
    border-radius: 8px;
    text-align: center;
  }

  .pilot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tungsten);
    margin: 0 auto 1.2rem;
    box-shadow: 0 0 18px 2px rgba(201, 116, 61, 0.55);
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin-bottom: 1.4rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--tungsten);
    color: var(--noir);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 6px;
    padding: 0.85rem 1.8rem;
  }

  .cta-button:hover {
    background: #d98449;
  }
</style>
