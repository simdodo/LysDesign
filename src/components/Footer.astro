---
import BrandLogo from "./BrandLogo.astro";

const year = new Date().getFullYear();

const footerLinks = [
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/services/", label: "Services" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/lighting-designer-oslo/", label: "Lighting Designer Oslo" },
];

const instagramUrl = "https://www.instagram.com/dodo_lightd";
const youtubeUrl = "https://www.youtube.com/@dodo_lightd";

const socialLinks = [
  { href: instagramUrl, label: "Instagram" },
  { href: youtubeUrl, label: "YouTube" },
].filter((link) => !link.href.includes("REPLACE_WITH_REAL"));
---

<footer class="site-footer" aria-label="Site footer">
  <div class="footer-main">
    <div class="footer-brand">
      <BrandLogo variant="clean" className="footer-logo" />
      <p>
        Oslo-based lighting design, programming &amp; live production.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {footerLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="footer-actions">
      <a
        class="footer-email"
        href="mailto:hello@defreitaslysdesign.com"
        aria-label="Email De Freitas Lys Design"
        data-track-event="contact_email_click"
      >
        Email
      </a>

      {socialLinks.length > 0 && (
        <nav class="footer-social" aria-label="Social profiles">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${link.label} profile`}
              data-track-event={link.label === "Instagram" ? "social_instagram_click" : "social_youtube_click"}
            >
              {link.label}
            </a>
          ))}
        </nav>
      )}

      <button type="button" data-cookie-settings>Cookie settings</button>
    </div>
  </div>

  <div class="footer-bottom">
    <small>&copy; {year} De Freitas Lys Design</small>
    <span>Oslo based + international</span>
  </div>
</footer>
