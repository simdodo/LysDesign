---
const {
  title = "Good shows usually start before load-in.",
  text = "Bring the room, the deadline, and the problems.",
  secondaryHref = "/portfolio/",
  secondaryLabel = "View Portfolio"
} = Astro.props;
---

<section class="home-final-cta" aria-labelledby="home-cta-title">
  <h2 id="home-cta-title">{title}</h2>
  <p>{text}</p>
  <div class="hero-actions" aria-label="Final homepage actions">
    <a class="cta btn-primary" href="/contact/">Start a Project</a>
    <a class="cta cta-secondary btn-secondary" href={secondaryHref}>{secondaryLabel}</a>
  </div>
</section>
