---
const {
  title = "Bring the music, the room and the deadline.",
  text = "Start with the real production conditions. The lighting workflow can follow from there.",
  secondaryHref = "/portfolio/",
  secondaryLabel = "View Portfolio"
} = Astro.props;
---

<section class="home-final-cta" aria-labelledby="home-cta-title">
  <h2 id="home-cta-title">{title}</h2>
  <p>{text}</p>
  <div class="hero-actions" aria-label="Final homepage actions">
    <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
    <a class="link-tertiary" href={secondaryHref} data-track-event={secondaryLabel === "View Portfolio" ? "cta_view_work" : undefined}>{secondaryLabel}</a>
  </div>
</section>
