---
const { process } = Astro.props;
---

<section class="home-section" aria-labelledby="process-title">
  <div class="section-kicker">HOW I WORK</div>
  <div class="section-heading">
    <h2 id="process-title">A practical workflow before the expensive part starts.</h2>
  </div>

  <div class="process-grid">
    {
      process.map((step, index) => (
        <article class="process-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))
    }
  </div>

  <div class="section-actions" aria-label="Workflow actions">
    <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
    <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">View Portfolio</a>
  </div>
</section>
