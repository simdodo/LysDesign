---
import OptimizedPicture from "./OptimizedPicture.astro";

const {
  image,
  alt = "Portfolio project image",
  width = 1600,
  height = 900,
  loading = "lazy",
  fetchpriority,
  widths,
  sizes,
  caption,
  className = ""
} = Astro.props;

const isPublicPath = typeof image === "string";
---

{
  image && (
    <figure class={`portfolio-image-frame ${className}`}>
      {isPublicPath ? (
        <img
          src={image}
          alt={alt}
          width={width}
          height={height}
          loading={loading}
          decoding="async"
          fetchpriority={fetchpriority}
          onerror="this.closest('.portfolio-image-frame').hidden = true"
        />
      ) : (
        <OptimizedPicture
          image={image}
          alt={alt}
          widths={widths}
          sizes={sizes}
          loading={loading}
          fetchpriority={fetchpriority}
        />
      )}

      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}
