---
import PageLabelBar from "./PageLabelBar.astro";

interface Props {
  title: string;
  subtitle: string;
  image: string;
  imageAlt?: string;
  label?: string;
  description?: string;
  proofPoints?: string[];
}

const {
  title,
  subtitle,
  image,
  imageAlt = "",
  label = "CUE 00 — BLACKOUT / FADE UP",
  description = "De Freitas Lys Design",
  proofPoints = []
} = Astro.props as Props;

const titleLines = title === "LIGHT THAT SURVIVES THE ROOM."
  ? ["LIGHT THAT", "SURVIVES", "THE ROOM."]
  : [title];
---

<section class="container hero-section" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="hero">
    <PageLabelBar label={label} description={description} className="hero-small" />

    <h1 id="hero-title" class="hero-title">
      {titleLines.map((line) => (
        <span class="hero-title-line">{line}</span>
      ))}
    </h1>

    <p>
      {subtitle}
    </p>

    <div class="hero-actions" aria-label="Homepage actions">
      <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project" data-astro-prefetch>Send the Brief</a>
      <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work" data-astro-prefetch>View the Work</a>
    </div>
  </div>

  {proofPoints.length > 0 && (
    <aside class="hero-technical-panel" aria-label="Production proof">
      <span>SHOWFILE / PROOF</span>
      <dl>
        {proofPoints.map((item, index) => (
          <div>
            <dt>{`SYS ${String(index + 1).padStart(2, "0")}`}</dt>
            <dd>{item}</dd>
          </div>
        ))}
      </dl>
    </aside>
  )}
</section>
