---
import PageLabelBar from "./PageLabelBar.astro";

const {
  title,
  subtitle,
  image,
  imageAlt = "",
  label = "Home",
  description = "De Freitas Lys Design"
} = Astro.props;
---

<section class="container hero-section" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      width="1600"
      height="900"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="hero">
    <PageLabelBar label={label} description={description} className="hero-small" />

    <h1 id="hero-title">
      {title}
    </h1>

    <p>
      {subtitle}
    </p>

    <div class="hero-actions" aria-label="Homepage actions">
      <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project" data-astro-prefetch>Start a Project</a>
      <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work" data-astro-prefetch>View Work</a>
    </div>
  </div>
</section>
