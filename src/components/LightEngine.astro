---
/**
 * The light layer. A fixed canvas blended in "screen" mode over the page:
 * it can only add light, never hide content. It follows two signals —
 * the chapter currently in view (sections carry data-light="...") and
 * the visitor's pointer, which carries a small warm source through the dark.
 * With prefers-reduced-motion, the canvas never mounts and the page
 * falls back to its static CSS lighting.
 */
---

<canvas id="light-engine" aria-hidden="true"></canvas>

<style>
  #light-engine {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
    mix-blend-mode: screen;
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('light-engine') as HTMLCanvasElement | null;

  if (!canvas || reduced) {
    canvas?.remove();
  } else {
    const ctx = canvas.getContext('2d')!;
    const finePointer = window.matchMedia('(pointer: fine)').matches;

    const tints: Record<string, [number, number, number]> = {};
    const styles = getComputedStyle(document.documentElement);
    for (const name of ['house', 'wait', 'impact', 'portrait', 'proof', 'live', 'song']) {
      const raw = styles.getPropertyValue(`--tint-${name}`).trim();
      if (raw) tints[name] = raw.split(',').map(Number) as [number, number, number];
    }

    let w = 0;
    let h = 0;
    let dpr = 1;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);

    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-light]'));
    const current: [number, number, number] = [...(tints.house ?? [18, 14, 12])] as [
      number,
      number,
      number,
    ];

    const pointer = { x: w / 2, y: h * 0.62, tx: w / 2, ty: h * 0.62, alpha: 0 };
    if (finePointer) {
      window.addEventListener(
        'pointermove',
        (e) => {
          pointer.tx = e.clientX;
          pointer.ty = e.clientY;
          pointer.alpha = 1;
        },
        { passive: true }
      );
    }

    // The active tint only changes on scroll/resize — cache it there so the
    // rAF loop never touches the DOM (getBoundingClientRect forces layout).
    let targetTint: [number, number, number] = tints.house ?? [18, 14, 12];
    const updateActiveTint = () => {
      const mid = h / 2;
      let best: HTMLElement | null = null;
      let bestDist = Infinity;
      for (const s of sections) {
        const r = s.getBoundingClientRect();
        const center = r.top + r.height / 2;
        const dist = Math.abs(center - mid);
        if (r.bottom > 0 && r.top < h && dist < bestDist) {
          bestDist = dist;
          best = s;
        }
      }
      targetTint = tints[best?.dataset.light ?? 'house'] ?? tints.house ?? [18, 14, 12];
    };
    window.addEventListener('scroll', updateActiveTint, { passive: true });
    window.addEventListener('resize', updateActiveTint);
    updateActiveTint();

    let running = true;
    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running) requestAnimationFrame(frame);
    });

    let t = 0;
    const frame = () => {
      if (!running) return;
      t += 0.008;

      const target = targetTint;
      for (let i = 0; i < 3; i++) current[i] += (target[i] - current[i]) * 0.03;

      pointer.x += (pointer.tx - pointer.x) * 0.08;
      pointer.y += (pointer.ty - pointer.y) * 0.08;

      ctx.clearRect(0, 0, w, h);

      const breath = 0.75 + 0.25 * Math.sin(t);
      const [r, g, b] = current.map(Math.round);

      const stage = ctx.createRadialGradient(w / 2, h * 1.05, 0, w / 2, h * 1.05, h * 0.9);
      stage.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${0.5 + 0.12 * breath})`);
      stage.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = stage;
      ctx.fillRect(0, 0, w, h);

      if (finePointer && pointer.alpha > 0.01) {
        const radius = Math.min(w, h) * 0.32;
        const halo = ctx.createRadialGradient(
          pointer.x,
          pointer.y,
          0,
          pointer.x,
          pointer.y,
          radius
        );
        halo.addColorStop(0, `rgba(201, 116, 61, ${0.09 * pointer.alpha})`);
        halo.addColorStop(0.5, `rgba(201, 116, 61, ${0.035 * pointer.alpha})`);
        halo.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = halo;
        ctx.fillRect(0, 0, w, h);
      }

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
