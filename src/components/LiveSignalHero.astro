---
import BrandLogo from "./BrandLogo.astro";
import PortfolioImage from "./PortfolioImage.astro";

interface Props {
  image: unknown;
  imageAlt: string;
  caption?: string;
  title: string;
  subtitle: string;
}

const {
  image,
  imageAlt,
  caption = "Live signal / room pressure / FOH decision",
  title,
  subtitle
} = Astro.props as Props;

const titleLines = title === "LIGHT THAT SURVIVES THE ROOM."
  ? ["LIGHT THAT", "SURVIVES", "THE ROOM."]
  : [title];
---

<section class="home-hero live-signal-hero" aria-labelledby="home-title">
  <div class="home-hero-media live-signal-hero__media" aria-hidden="true">
    <PortfolioImage
      image={image}
      alt={imageAlt}
      loading="eager"
      fetchpriority="high"
      widths={[768, 1024, 1280, 1600, 1920]}
      sizes="100vw"
      caption={caption}
    />
  </div>

  <div class="live-signal-hero__grid">
    <div class="live-signal-hero__logo">
      <BrandLogo variant="live" />
    </div>

    <div class="home-hero-content live-signal-hero__content">
      <p class="signal-eyebrow">BLACKOUT / SIGNAL LOCK / LIVE ROOM</p>

      <h1 id="home-title">
        {titleLines.map((line, index) => (
          <>
            <span>{line}</span>{index < titleLines.length - 1 && " "}
          </>
        ))}
      </h1>

      <p>{subtitle}</p>

      <div class="hero-actions" aria-label="Home actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        <a class="cta cta-secondary btn-secondary" href="/portfolio/" data-track-event="cta_view_work">View Work</a>
      </div>
    </div>
  </div>
</section>
