---
import type { ImageMetadata } from 'astro';
import LightEngine from './LightEngine.astro';
import ImagineReel from './ImagineReel.astro';
import { home, contact, pathForLocale, type Locale } from '../i18n/ui';
import { work } from '../data/work';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale];
const year = new Date().getFullYear();

const pilot = work.find((w) => w.slug === 'roller-disco');
const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portfolio/*/cover.jpg',
  { eager: true }
);
const pilotCover = pilot
  ? covers[`../assets/portfolio/${pilot.image}/cover.jpg`]?.default
  : undefined;
---

<LightEngine />

<header class="hero" data-light="house">
  <p class="mono-label cue" style="--cue: 0.1s">{t.houseLine}</p>
  <p class="hero-label mono-label cue" style="--cue: 0.4s">{t.heroLabel}</p>
  <h1>
    <span class="cue" style="--cue: 0.8s">{t.heroTitleA}</span>
    <span class="cue" style="--cue: 1.6s">{t.heroTitleB}</span>
  </h1>
  <p class="hero-sub cue" style="--cue: 2.2s">{t.heroSub}</p>
  <p class="scroll-hint mono-label cue" style="--cue: 2.6s">{t.scrollHint} ↓</p>
</header>

{
  t.chapters.map((chapter) => (
    <section class="chapter" id={chapter.id} data-light={chapter.light}>
      <div class="chapter-inner lit-in">
        <p class="mono-label">{chapter.label}</p>
        <h2>{chapter.title}</h2>
        {chapter.body.map((line) => (
          <p class="chapter-body">{line}</p>
        ))}
      </div>
    </section>
  ))
}

<section class="proof" id="work" data-light="proof">
  <div class="proof-inner lit-in">
    <p class="mono-label">{t.work.label}</p>
    <h2>{t.work.title}</h2>
    <p class="chapter-body">{t.work.intro}</p>

    {
      pilot && pilotCover && (
        <ImagineReel locale={locale} realImage={pilotCover} alt={pilot.imageAlt} />
      )
    }

    <ul class="designs">
      {
        work.map((w) => (
          <li>
            <a class="design-link" href={pathForLocale(locale, `/work/${w.slug}/`)}>
              <span class="design-name">{w.copy[locale].title}</span>
              <span class="design-context">{w.copy[locale].context}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="record">
      <p class="mono-label">{t.work.touringLabel}</p>
      <p class="record-line">{t.work.touring}</p>
      <p class="mono-label">{t.work.roomsLabel}</p>
      <p class="record-line">{t.work.rooms}</p>
    </div>

    <p class="proof-note">{t.work.proofNote}</p>
  </div>
</section>

<section class="chapter" id="live" data-light="live">
  <div class="chapter-inner lit-in">
    <p class="mono-label">{t.busking.label}</p>
    <h2>{t.busking.title}</h2>
    {t.busking.body.map((line) => <p class="chapter-body">{line}</p>)}
    <p class="watch-line">{t.busking.watch}</p>
    <a class="watch-cta" href={contact.youtube} rel="noopener">{t.busking.watchCta} →</a>
  </div>
</section>

<section class="song" id="send-a-song" data-light="song">
  <div class="song-inner lit-in">
    <span class="pilot" aria-hidden="true"></span>
    <p class="mono-label">{t.song.label}</p>
    <h2>{t.song.title}</h2>
    <p class="chapter-body">{t.song.body}</p>
    <p class="song-promise">{t.song.promise}</p>

    <form action={`https://formsubmit.co/${contact.email}`} method="POST">
      <input type="hidden" name="_subject" value="New track from defreitaslysdesign.com" />
      <input
        type="hidden"
        name="_next"
        value={`https://defreitaslysdesign.com${pathForLocale(locale, '/merci/')}`}
      />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
      <label>
        <span class="sr-only">{t.song.placeholderLink}</span>
        <input type="text" name="track" placeholder={t.song.placeholderLink} required />
      </label>
      <div class="form-row">
        <label>
          <span class="sr-only">{t.song.placeholderName}</span>
          <input type="text" name="name" placeholder={t.song.placeholderName} required />
        </label>
        <label>
          <span class="sr-only">{t.song.placeholderEmail}</span>
          <input type="email" name="email" placeholder={t.song.placeholderEmail} required />
        </label>
      </div>
      <label>
        <span class="sr-only">{t.song.placeholderNote}</span>
        <textarea name="note" rows="3" placeholder={t.song.placeholderNote}></textarea>
      </label>
      <button type="submit">{t.song.submit}</button>
    </form>

    <p class="direct">
      {t.song.directLine}
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
  </div>
</section>

<footer>
  <p class="footer-name">Dorian De Freitas</p>
  <p class="footer-role">{t.footer.role}</p>
  <p class="footer-based">{t.footer.based}</p>
  <p class="footer-watch">
    {t.footer.watch}
    <a href={contact.youtube} rel="noopener">YouTube — @dodo_lightd</a>
    ·
    <a href={contact.instagram} rel="noopener">Instagram</a>
  </p>
  <p class="footer-legal mono-label">© {year} De Freitas Lysdesign — Oslo</p>
</footer>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .hero,
  .chapter,
  .proof,
  .song {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem var(--pad-x);
    position: relative;
  }

  .hero {
    align-items: flex-start;
    gap: 1.4rem;
  }

  .hero-label {
    color: var(--tungsten);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cue {
      opacity: 0;
      animation: cue-in 1.3s cubic-bezier(0.2, 0, 0.2, 1) both;
      animation-delay: var(--cue, 0s);
    }

    @keyframes cue-in {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  .hero-sub {
    max-width: var(--measure);
    color: var(--gris);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: var(--pad-x);
  }

  .chapter {
    align-items: center;
    text-align: center;
  }

  .chapter-inner,
  .proof-inner,
  .song-inner {
    max-width: var(--measure);
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.08;
    margin: 0.9rem 0 1.6rem;
    text-wrap: balance;
  }

  .chapter-body {
    color: var(--gris);
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .proof {
    align-items: center;
  }

  .proof-inner {
    max-width: 44rem;
  }

  .designs {
    list-style: none;
    padding: 0;
    margin: 2.4rem 0;
    border-top: 1px solid var(--ligne);
  }

  .designs li {
    border-bottom: 1px solid var(--ligne);
  }

  .design-link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.2rem 1.5rem;
    padding: 0.9rem 0;
    text-decoration: none;
  }

  .design-link:hover .design-name {
    color: var(--tungsten);
  }

  .design-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .design-context {
    color: var(--gris-2);
    font-size: 0.9rem;
  }

  .record {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 2rem;
  }

  .record-line {
    color: var(--gris);
    font-size: 0.95rem;
    margin-bottom: 1.1rem;
  }

  .proof-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--gris-2);
  }

  .watch-line {
    color: var(--gris-2);
    font-size: 0.9rem;
    margin-top: 1.6rem;
  }

  .watch-cta {
    display: inline-block;
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tungsten);
    text-decoration: none;
    border: 1px solid var(--tungsten-dim);
    border-radius: 6px;
    padding: 0.7rem 1.3rem;
  }

  .watch-cta:hover {
    border-color: var(--tungsten);
    color: #d98449;
  }

  .song {
    align-items: center;
    text-align: center;
  }

  .pilot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tungsten);
    margin: 0 auto 1.6rem;
    box-shadow: 0 0 18px 2px rgba(201, 116, 61, 0.55);
  }

  .song-promise {
    color: var(--gris-2);
    font-size: 0.95rem;
    margin: 0.4rem 0 2.2rem;
  }

  form {
    display: grid;
    gap: 0.8rem;
    width: min(100%, 30rem);
    margin: 0 auto;
    text-align: left;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  @media (max-width: 34rem) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  input,
  textarea {
    width: 100%;
    background: var(--noir-2);
    border: 1px solid var(--ligne);
    border-radius: 6px;
    color: var(--blanc);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.8rem 1rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--gris-2);
  }

  input:focus,
  textarea:focus {
    border-color: var(--tungsten-dim);
    outline: none;
  }

  textarea {
    resize: vertical;
  }

  button {
    justify-self: start;
    background: var(--tungsten);
    color: var(--noir);
    border: none;
    border-radius: 6px;
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.8rem;
    cursor: pointer;
  }

  button:hover {
    background: #d98449;
  }

  .direct {
    margin-top: 2rem;
    color: var(--gris-2);
    font-size: 0.9rem;
  }

  .direct a {
    color: var(--gris);
  }

  footer {
    padding: 4rem var(--pad-x) 3rem;
    border-top: 1px solid var(--ligne);
    display: grid;
    gap: 0.3rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .footer-role,
  .footer-based,
  .footer-watch {
    color: var(--gris-2);
    font-size: 0.9rem;
  }

  .footer-watch a {
    color: var(--gris);
  }

  .footer-legal {
    margin-top: 1.6rem;
  }
</style>

<script>
  const items = document.querySelectorAll('.lit-in');
  if (!('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-lit'));
  }
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-lit');
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.25 }
  );
  items.forEach((el) => io.observe(el));
</script>
