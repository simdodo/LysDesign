---
import PortfolioImage from "./PortfolioImage.astro";

interface Props {
  href: string;
  image: unknown;
  alt: string;
  caption?: string;
  title: string;
  meta?: string;
  trackingEvent?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  href,
  image,
  alt,
  caption,
  title,
  meta,
  trackingEvent,
  loading = "lazy",
  fetchpriority
} = Astro.props as Props;
---

<a class="scene-card" href={href} data-track-event={trackingEvent} data-astro-prefetch>
  <PortfolioImage
    image={image}
    alt={alt}
    caption={caption}
    loading={loading}
    fetchpriority={fetchpriority}
  />
  <span>{title}</span>
  {meta && <small>{meta}</small>}
</a>
