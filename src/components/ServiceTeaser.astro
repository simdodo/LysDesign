---
interface Service {
  title: string;
  description: string;
  cta: string;
  href: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props as Props;
---

<section class="home-section" aria-labelledby="home-services-title">
  <div class="section-kicker">WHAT I DO</div>
  <div class="section-heading">
    <h2 id="home-services-title">Lighting work for real production conditions.</h2>
    <p>
      Lighting design, GrandMA programming, FOH operation and previs support for
      shows that need to stay playable in real rooms.
    </p>
  </div>

  <div class="home-service-index">
    {
      services.map((service) => (
        <a class="home-service-row" href={service.href}>
          <span>{service.title}</span>
          <p>{service.description}</p>
          <strong>{service.cta}</strong>
        </a>
      ))
    }
  </div>

  <div class="section-actions section-actions--quiet" aria-label="Services actions">
    <a class="link-tertiary" href="/services/">Open the service index</a>
  </div>
</section>
