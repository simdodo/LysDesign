---
import PortfolioImage from "./PortfolioImage.astro";

interface Scene {
  image?: unknown;
  alt?: string;
  caption?: string;
}

interface Props {
  scenes?: Scene[];
  title?: string;
}

const { scenes = [], title = "Documented scene" } = Astro.props as Props;
const visibleScenes = scenes.filter((scene) => scene?.image).slice(0, 3);
---

{visibleScenes.length > 0 && (
  <section class={`scene-gallery scene-gallery--count-${visibleScenes.length}`} aria-labelledby="scene-gallery-title">
    <div class="section-kicker">SCENE DOCUMENTATION</div>
    <h2 id="scene-gallery-title">{title}</h2>

    <div class="scene-gallery-grid">
      {visibleScenes.map((scene, index) => (
        <PortfolioImage
          image={scene.image}
          alt={scene.alt}
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : undefined}
          caption={scene.caption}
          className={index === 0 ? "scene-gallery-primary" : "scene-gallery-detail"}
        />
      ))}
    </div>
  </section>
)}
