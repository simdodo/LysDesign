---
import LightEngine from './LightEngine.astro';
import { about } from '../data/about';
import { caseUi } from '../data/work';
import { contact, pathForLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = about[locale];
const c = caseUi[locale];
---

<LightEngine />

<article class="story" data-light="portrait">
  <header>
    <p class="mono-label">{t.label}</p>
    <h1>{t.title}</h1>
  </header>

  <div class="body">
    {t.paragraphs.map((p) => <p>{p}</p>)}
  </div>

  <section class="record" data-light="proof">
    <p class="mono-label">{t.recordLabel}</p>
    <dl>
      {
        t.groups.map((g) => (
          <div class="row">
            <dt class="mono-label">{g.label}</dt>
            <dd>{g.items}</dd>
          </div>
        ))
      }
    </dl>
    <p class="cv-line">
      {t.cvLine}
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
  </section>

  <aside class="cta" data-light="song">
    <span class="pilot" aria-hidden="true"></span>
    <p class="cta-title">{c.ctaTitle}</p>
    <a class="cta-button" href={pathForLocale(locale, '/') + '#send-a-song'}>{c.ctaButton}</a>
  </aside>
</article>

<style>
  .story {
    max-width: 44rem;
    margin: 0 auto;
    padding: 8rem var(--pad-x) 4rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
    margin: 0.8rem 0 2.2rem;
    text-wrap: balance;
  }

  .body p {
    color: var(--gris);
    font-size: 1.05rem;
    margin-bottom: 1.2rem;
    max-width: var(--measure);
  }

  .record {
    margin-top: 3.5rem;
  }

  dl {
    margin: 1.2rem 0 0;
    border-top: 1px solid var(--ligne);
  }

  .row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.4rem 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--ligne);
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }

  dt {
    padding-top: 0.15rem;
  }

  dd {
    margin: 0;
    color: var(--gris);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .cv-line {
    margin-top: 1.6rem;
    color: var(--gris-2);
    font-size: 0.9rem;
  }

  .cv-line a {
    color: var(--gris);
  }

  .cta {
    margin-top: 4rem;
    padding: 3rem 1.5rem;
    border: 1px solid var(--ligne);
    border-radius: 8px;
    text-align: center;
  }

  .pilot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tungsten);
    margin: 0 auto 1.2rem;
    box-shadow: 0 0 18px 2px rgba(201, 116, 61, 0.55);
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin-bottom: 1.4rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--tungsten);
    color: var(--noir);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 6px;
    padding: 0.85rem 1.8rem;
  }

  .cta-button:hover {
    background: #d98449;
  }
</style>
