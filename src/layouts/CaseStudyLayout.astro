---
import Layout from "./Layout.astro";
import PageLabelBar from "../components/PageLabelBar.astro";
import PortfolioImage from "../components/PortfolioImage.astro";
import SceneGallery from "../components/SceneGallery.astro";
import LightStateGallery from "../components/LightStateGallery.astro";
import ProjectNarrative from "../components/ProjectNarrative.astro";
import ProjectTechnicalPanel from "../components/ProjectTechnicalPanel.astro";
import SignalDivider from "../components/SignalDivider.astro";

const { project } = Astro.props;
const data = project.data;
const canonicalPath = `/portfolio/${project.id}/`;
const ogImage = data.cover?.src ?? "/images/portfolio/touring/cover.jpg";
const serviceLinks: Record<string, { href: string; label: string }> = {
  Touring: {
    href: "/services/touring-showfiles/",
    label: "Touring showfile service"
  },
  Dance: {
    href: "/services/dance-theatre-lighting/",
    label: "Dance and theatre lighting service"
  },
  Festival: {
    href: "/services/festival-lighting/",
    label: "Festival lighting service"
  },
  "Visual Direction": {
    href: "/services/lighting-design/",
    label: "Lighting design service"
  },
  Previsualization: {
    href: "/services/unreal-previs/",
    label: "Unreal previs service"
  },
  "Special Project": {
    href: "/services/lighting-programming/",
    label: "Lighting programming service"
  }
};
const relatedService = serviceLinks[data.format];
const relatedServices = data.relatedServices.length > 0
  ? data.relatedServices
  : relatedService
    ? [relatedService]
    : [];
const productionContext = data.productionContext ?? (
  data.selectedProjects.length > 0
    ? data.selectedProjects.join(" / ")
    : data.format
);
const sceneGalleryFormats = new Set(["Touring", "Festival", "Dance"]);
const sceneGalleryTitles: Record<string, string> = {
  Touring: "FOH, file, room.",
  Festival: "Changeover, daylight, local rig.",
  Dance: "Body, silence, focus."
};
const sceneCaptions: Record<string, string> = {
  Touring: "Emotional read: stage depth, artist picture and the console position in one frame.",
  Festival: "Pressure read: crowd, daylight and local rig limits visible before the show starts.",
  Dance: "Focus read: bodies, darkness and silence deciding where the cue can land."
};
const sceneGalleryItems = [
  {
    image: data.cover,
    alt: data.coverAlt,
    caption: sceneCaptions[data.format] ?? `${data.format} / ${data.role} / ${data.location} / ${data.year}`
  },
  ...data.gallery.slice(0, 2).map((image: unknown, index: number) => ({
    image,
    alt: `${data.title} detail image ${index + 1}`,
    caption: index === 0
      ? `Technical read: ${data.systemWorkflow ?? data.systems.join(" / ")} translated into the room.`
      : `Detail read: ${data.constraint ?? data.productionProblem ?? data.challenge}`
  }))
];
const changedOnSite = data.whatChangedOnSite ?? data.changedOnSite;
const structuredSnapshot = [
  {
    label: "PRODUCTION",
    title: productionContext,
    copy: data.venueContext ?? data.location
  },
  {
    label: "SYSTEM",
    title: data.systemWorkflow ?? data.systems.join(" / "),
    copy: data.role
  },
  {
    label: "CONSTRAINT",
    title: data.constraint ?? data.productionProblem ?? data.challenge,
    copy: data.truth ?? data.challenge
  },
  {
    label: "SOLUTION",
    title: data.solution ?? data.response ?? "Practical production workflow",
    copy: data.approach
  },
  {
    label: "RESULT",
    title: data.outcome ?? data.stayedConsistent ?? "Readable show result",
    copy: data.result
  },
  {
    label: "CREDITS",
    title: data.mediaCredits ?? "Project media shown with limited public credits.",
    copy: "Additional names, venues or production details can be added when cleared for publication."
  }
];

const creativeWork = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: data.title,
  description: data.description,
  url: `https://defreitaslysdesign.com${canonicalPath}`,
  image: `https://defreitaslysdesign.com${ogImage}`,
  creator: {
    "@type": "Person",
    name: "Dorian De Freitas"
  },
  genre: data.format,
  keywords: [...data.tags, ...data.systems].join(", ")
};
---

<Layout
  title={`${data.title} | De Freitas Lys Design`}
  description={data.description}
  image={ogImage}
  structuredData={creativeWork}
>
  <main class="services-page case-study-page" id="main-content">
    <section class="services-hero case-study-hero" aria-labelledby="case-study-title">
      <PageLabelBar label={data.format} description="Case Study" />

      {!sceneGalleryFormats.has(data.format) && (
        <PortfolioImage
          image={data.cover}
          alt={data.coverAlt}
          loading="eager"
          fetchpriority="high"
          caption={`${data.format} / ${data.role} / ${data.location} / ${data.year}`}
        />
      )}

      <h1 id="case-study-title">{data.title}</h1>
      <p>{data.subtitle}</p>

      <ProjectTechnicalPanel data={data} />

      <ul class="hero-proof" aria-label="Tags and systems">
        {[...data.tags, ...data.systems].map((item) => (
          <li>{item}</li>
        ))}
      </ul>

    </section>

    <ProjectNarrative data={data} />

    {sceneGalleryFormats.has(data.format) && (
      <SceneGallery
        scenes={sceneGalleryItems}
        title={sceneGalleryTitles[data.format] ?? `${data.title} documented as a scene.`}
      />
    )}

    <LightStateGallery states={data.lightStates} title={`${data.title} / light states`} />

    {changedOnSite && (
      <section class="case-study-sections project-site-change" aria-label="What changed on site">
        <article class="case-study-change">
          <span>WHAT CHANGED ON SITE</span>
          <h2>{changedOnSite}</h2>
          <p>{data.truth ?? "The workflow had to stay readable under production pressure."}</p>
        </article>
      </section>
    )}

    <section class="case-study-sections" aria-label="Structured production details">
      {structuredSnapshot.map((item) => (
        <article>
          <span>{item.label}</span>
          <h2>{item.title}</h2>
          <p>{item.copy}</p>
        </article>
      ))}

      {relatedServices.length > 0 && (
        <article>
          <span>Related services</span>
          <h2>Production support connected to this case.</h2>
          <ul>
            {relatedServices.map((service: { href: string; label: string }) => (
              <li><a href={service.href}>{service.label}</a></li>
            ))}
          </ul>
        </article>
      )}
    </section>

    {data.mediaItems.length > 0 && (
      <section class="case-study-sections" aria-label="Media and documentation proof">
        {data.mediaItems.map((item: { label: string; detail: string; credit?: string }) => (
          <article>
            <span>Media / documentation</span>
            <h2>{item.label}</h2>
            <p>{item.detail}</p>
            {item.credit && <p>{item.credit}</p>}
          </article>
        ))}
      </section>
    )}

    <section class="case-study-notes" aria-labelledby="technical-notes-title">
      <SignalDivider label="Technical Notes" detail="Workflow / room / file" />
      <div class="case-study-note-body">
        <h2 id="technical-notes-title">Notes from the workflow</h2>
        <slot />
      </div>
    </section>

    {!sceneGalleryFormats.has(data.format) && data.gallery.length > 0 && (
      <section class="case-study-gallery" aria-label="Project gallery">
        {data.gallery.map((image: unknown) => (
          <PortfolioImage image={image} alt={`${data.title} gallery image`} caption={`${data.title} / detail documentation`} />
        ))}
      </section>
    )}

    <section class="services-cta" aria-labelledby="case-study-contact-title">
      <div>
        <SignalDivider label="Next Step" detail="Brief / room / system" />
        <h2 id="case-study-contact-title">Need this kind of workflow on your production?</h2>
      </div>

      <p>Send the room, dates, system information and what is still unknown.</p>

      <div class="hero-actions" aria-label="Case study contact actions">
        <a class="cta btn-primary" href="/contact/" data-track-event="cta_start_project">Start a Project</a>
        {relatedService && <a class="link-tertiary" href={relatedService.href}>{relatedService.label}</a>}
      </div>
    </section>
  </main>
</Layout>
