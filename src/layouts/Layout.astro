---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const {
  title = "De Freitas Lys Design",
  description = "Premium lighting design, programming, and creative technology for concerts, touring, and live visual environments."
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <title>{title}</title>
  </head>

  <body>
    <Navbar />
    <slot />
  </body>
</html>
