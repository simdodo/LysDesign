---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";

const {
  title = "De Freitas Lys Design",
  description = "Premium lighting design, programming, and creative technology for concerts, touring, and live visual environments.",
  image = "/images/portfolio/touring/cover.jpg",
  preloadImage,
  structuredData = []
} = Astro.props;

const siteUrl = Astro.site ?? "https://defreitaslysdesign.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL(image, siteUrl);
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: new URL("/", siteUrl).toString()
  },
  ...pathSegments.map((segment, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name: segment
      .split("-")
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(" "),
    item: new URL(`/${pathSegments.slice(0, index + 1).join("/")}/`, siteUrl).toString()
  }))
];

const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "De Freitas Lys Design",
    url: new URL("/", siteUrl).toString()
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "De Freitas Lys Design",
    url: new URL("/", siteUrl).toString(),
    image: ogImageUrl.toString(),
    areaServed: ["Norway", "Europe"],
    serviceType: [
      "Lighting design",
      "Lighting programming",
      "Touring lighting systems",
      "Festival lighting operation",
      "Previsualization"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Dorian De Freitas",
    jobTitle: "Lighting Designer, Programmer and Operator",
    url: new URL("/about/", siteUrl).toString(),
    sameAs: [
      "https://www.instagram.com/dodo_lightd",
      "https://www.youtube.com/@dodo_lightd"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems
  }
];

const jsonLd = [
  ...baseStructuredData,
  ...(Array.isArray(structuredData) ? structuredData : [structuredData]).filter(Boolean)
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="De Freitas Lys Design" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <title>{title}</title>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("consent", "default", {
        analytics_storage: "denied"
      });
      gtag("js", new Date());
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3SGMFRGL79"></script>
    {jsonLd.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar />
    <slot />
    <Footer />
    <CookieConsent />
    <script is:inline>
      (() => {
        const allowedEvents = new Set([
          "cta_start_project",
          "cta_view_work",
          "contact_form_submit",
          "contact_email_click",
          "social_instagram_click",
          "social_youtube_click",
          "portfolio_case_study_click"
        ]);

        const hasAnalyticsConsent = () => {
          try {
            return window.localStorage.getItem("dfld_cookie_consent") === "accepted";
          } catch {
            return false;
          }
        };

        const sendEvent = (name, parameters = {}) => {
          if (!allowedEvents.has(name)) return;
          if (!hasAnalyticsConsent()) return;
          if (typeof window.gtag !== "function") return;
          window.gtag("event", name, parameters);
        };

        document.addEventListener("click", (event) => {
          const clicked = event.target instanceof Element ? event.target : null;
          const target = clicked?.closest("[data-track-event]");
          const link = target ?? clicked?.closest("a, button");
          if (!link) return;
          const label = link.textContent?.trim() || "";
          const href = link.href || "";
          const inferredEvent = label === "Start a Project"
            ? "cta_start_project"
            : label === "View Work" || label === "View Portfolio"
              ? "cta_view_work"
              : "";
          const eventName = target?.dataset.trackEvent || inferredEvent;
          if (!eventName) return;

          sendEvent(eventName, {
            link_url: href,
            link_text: label
          });
        });

        document.addEventListener("submit", (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          if (!form.dataset.trackEvent) return;

          sendEvent(form.dataset.trackEvent, {
            form_id: form.id || "",
            form_name: form.getAttribute("name") || ""
          });
        });
      })();
    </script>
  </body>
</html>
