<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.defreitaslysdesign\.com$ [NC]
  RewriteRule ^(.*)$ https://defreitaslysdesign.com/$1 [R=301,L]

  # --- Legacy URLs from the previous site → closest current equivalent ---
  # Specific mappings first, catch-alls last. NE keeps #fragments intact.
  RewriteRule ^portfolio/touring-lighting-showfiles/?$ /work/touring-france/ [R=301,L]
  RewriteRule ^portfolio/contemporary-dance-lighting/?$ /work/panta-rei/ [R=301,L]
  RewriteRule ^portfolio/festival-venue-adaptation/?$ /work/kaleidoscope-shi-pratt/ [R=301,L]
  RewriteRule ^portfolio/unreal-visualization/?$ /work/queer-the-wack/ [R=301,L]
  RewriteRule ^portfolio/visual-direction/?$ /work/soul-sessions/ [R=301,L]
  RewriteRule ^portfolio/special-projects/?$ /work/roller-disco/ [R=301,L]
  RewriteRule ^portfolio(/.*)?$ /#work [R=301,NE,L]

  RewriteRule ^services/touring-showfiles/?$ /work/touring-france/ [R=301,L]
  RewriteRule ^services/remote-showfile-support/?$ /work/touring-france/ [R=301,L]
  RewriteRule ^services/festival-lighting/?$ /work/kaleidoscope-shi-pratt/ [R=301,L]
  RewriteRule ^services/dance-theatre-lighting/?$ /work/panta-rei/ [R=301,L]
  RewriteRule ^services/unreal-previs/?$ /work/queer-the-wack/ [R=301,L]
  RewriteRule ^services/lighting-design/?$ /#work [R=301,NE,L]
  RewriteRule ^services/lighting-programming/?$ /#work [R=301,NE,L]
  RewriteRule ^services(/.*)?$ / [R=301,L]

  RewriteRule ^contact/?$ /#send-a-song [R=301,NE,L]
  RewriteRule ^lighting-designer-oslo/?$ / [R=301,L]
  RewriteRule ^design-lab/?$ / [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
  Header set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://formsubmit.co; form-action 'self' https://formsubmit.co"

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
